<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- O botao A mostra uma medida; o botao B muda para o grafico. -->
  <block type="botao_se_apertado" x="20" y="20"><field name="BOTAO">A</field><statement name="DO"><block type="display_limpar"><field name="DISPLAY_TYPE">SMALL</field><next><block type="display_texto"><field name="TEXTO">Distancia pelo A:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field><next><block type="display_mostrar_valor"><field name="LINHA">2</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="ultrassonico_distancia"><field name="TRIG">3</field><field name="ECHO">2</field></block></value></block></next></block></next></block></statement><next><block type="botao_se_apertado"><field name="BOTAO">B</field><statement name="DO"><block type="ultrassonico_plotar"><field name="POSICAO">0</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="ultrassonico_distancia"><field name="TRIG">3</field><field name="ECHO">2</field></block></value></block></statement></block></next></block>
</xml>

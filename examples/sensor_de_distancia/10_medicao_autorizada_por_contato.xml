<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- O contato 0 autoriza a medicao; separado, ele pede para o aluno encostar. -->
  <block type="external_contact_prepare" x="20" y="20"><field name="COMMON">GND</field><next><block type="controls_ifelse">
    <value name="IF0"><block type="external_contact_is_closed"><field name="DIG">0</field></block></value>
    <statement name="DO0"><block type="display_limpar"><field name="DISPLAY_TYPE">SMALL</field><next><block type="display_texto"><field name="TEXTO">Distancia:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field><next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="ultrassonico_distancia"><field name="TRIG">3</field><field name="ECHO">2</field></block></value></block></next></block></next></block></statement>
    <statement name="ELSE"><block type="display_limpar"><field name="DISPLAY_TYPE">SMALL</field><next><block type="display_texto"><field name="TEXTO">Encoste para medir</field><field name="LINHA">1</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field></block></next></block></statement>
    <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">300</field></block></value></block></next>
  </block></next></block>
</xml>

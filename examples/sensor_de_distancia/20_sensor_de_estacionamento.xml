<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Projeto final: dois canais do KY-016, buzzer, display e grafico formam um sensor de estacionamento. -->
  <block type="led_externo_desligar" x="20" y="20"><field name="CHANNEL">R</field><field name="DIG">0</field><next><block type="led_externo_desligar"><field name="CHANNEL">G</field><field name="DIG">1</field><next><block type="controls_ifelse">
    <value name="IF0"><block type="logic_compare"><field name="OP">LT</field><value name="A"><block type="ultrassonico_distancia"><field name="TRIG">3</field><field name="ECHO">2</field></block></value><value name="B"><block type="math_number"><field name="NUM">10</field></block></value></block></value>
    <statement name="DO0"><block type="led_externo_ligar"><field name="CHANNEL">R</field><field name="DIG">0</field><next><block type="led_externo_desligar"><field name="CHANNEL">G</field><field name="DIG">1</field><next><block type="bipe_duplo"><field name="VOLUME">40</field></block></next></block></next></block></statement>
    <statement name="ELSE"><block type="controls_ifelse">
      <value name="IF0"><block type="logic_compare"><field name="OP">LT</field><value name="A"><block type="ultrassonico_distancia"><field name="TRIG">3</field><field name="ECHO">2</field></block></value><value name="B"><block type="math_number"><field name="NUM">30</field></block></value></block></value>
      <statement name="DO0"><block type="led_externo_ligar"><field name="CHANNEL">R</field><field name="DIG">0</field><next><block type="led_externo_ligar"><field name="CHANNEL">G</field><field name="DIG">1</field><next><block type="bipe_curto"><field name="VOLUME">25</field></block></next></block></next></block></statement>
      <statement name="ELSE"><block type="led_externo_desligar"><field name="CHANNEL">R</field><field name="DIG">0</field><next><block type="led_externo_ligar"><field name="CHANNEL">G</field><field name="DIG">1</field></block></next></block></statement>
    </block></statement>
    <next><block type="display_texto"><field name="TEXTO">Distancia:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field><next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="ultrassonico_distancia"><field name="TRIG">3</field><field name="ECHO">2</field></block></value><next><block type="ultrassonico_plotar"><field name="POSICAO">2</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="ultrassonico_distancia"><field name="TRIG">3</field><field name="ECHO">2</field></block></value><next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">300</field></block></value></block></next></block></next></block></next></block></next>
  </block></next></block></next></block>
</xml>

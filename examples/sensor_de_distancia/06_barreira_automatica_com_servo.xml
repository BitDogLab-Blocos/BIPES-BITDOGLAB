<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Um objeto proximo abre a barreira; quando ele se afasta, a barreira fecha. -->
  <block type="controls_ifelse" x="20" y="20">
    <value name="IF0"><block type="logic_compare"><field name="OP">LT</field><value name="A"><block type="ultrassonico_distancia"><field name="TRIG">3</field><field name="ECHO">2</field></block></value><value name="B"><block type="math_number"><field name="NUM">25</field></block></value></block></value>
    <statement name="DO0"><block type="servo_mover"><field name="DIG">0</field><field name="ANGLE">90</field><next><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_green"></block></value></block></next></block></statement>
    <statement name="ELSE"><block type="servo_mover"><field name="DIG">0</field><field name="ANGLE">0</field><next><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_blue"></block></value></block></next></block></statement>
    <next><block type="display_texto"><field name="TEXTO">Distancia:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field><next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="ultrassonico_distancia"><field name="TRIG">3</field><field name="ECHO">2</field></block></value></block></next></block></next>
  </block>
</xml>

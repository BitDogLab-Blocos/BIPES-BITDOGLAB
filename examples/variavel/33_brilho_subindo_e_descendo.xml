<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Brilho sobe de 0 a 100 e desce ate 0 usando a mesma variavel. -->
  <block type="variables_guardar" x="20" y="20">
    <field name="VAR">intensidade led</field>
    <value name="VALUE">
      <block type="math_number">
        <field name="NUM">0</field>
      </block>
    </value>
    <next>
      <block type="controls_repeat_simple">
        <field name="TIMES">10</field>
        <statement name="DO">
          <block type="bloco_acender_led_brilho">
            <value name="COLOUR">
              <block type="colour_green"></block>
            </value>
            <value name="INTENSITY">
              <block type="variables_valor_guardado">
                <field name="VAR">intensidade led</field>
              </block>
            </value>
            <next>
              <block type="esperar_segundos">
                <value name="TIME">
                  <block type="math_number">
                    <field name="NUM">1</field>
                  </block>
                </value>
                <next>
                  <block type="variables_alterar">
                    <field name="VAR">intensidade led</field>
                    <value name="TARGET">
                      <block type="variables_valor_guardado">
                        <field name="VAR">intensidade led</field>
                      </block>
                    </value>
                    <value name="VALUE">
                      <block type="math_arithmetic">
                        <field name="OP">ADD</field>
                        <value name="A">
                          <block type="variables_valor_guardado">
                            <field name="VAR">intensidade led</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number">
                            <field name="NUM">10</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <next>
                      <block type="display_mostrar_valor">
                        <field name="LINHA">1</field>
                        <field name="ALINHAMENTO">LEFT</field>
                        <field name="DISPLAY_TYPE">SMALL</field>
                        <value name="VALOR">
                          <block type="variables_valor_guardado">
                            <field name="VAR">intensidade led</field>
                          </block>
                        </value>
                        <next>
                          <block type="esperar_segundos">
                            <value name="TIME">
                              <block type="math_number">
                                <field name="NUM">1</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="esperar_segundos">
            <value name="TIME">
              <block type="math_number">
                <field name="NUM">5</field>
              </block>
            </value>
            <next>
              <block type="controls_repeat_simple">
                <field name="TIMES">10</field>
                <statement name="DO">
                  <block type="bloco_acender_led_brilho">
                    <value name="COLOUR">
                      <block type="colour_green"></block>
                    </value>
                    <value name="INTENSITY">
                      <block type="variables_valor_guardado">
                        <field name="VAR">intensidade led</field>
                      </block>
                    </value>
                    <next>
                      <block type="esperar_segundos">
                        <value name="TIME">
                          <block type="math_number">
                            <field name="NUM">1</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_alterar">
                            <field name="VAR">intensidade led</field>
                            <value name="TARGET">
                              <block type="variables_valor_guardado">
                                <field name="VAR">intensidade led</field>
                              </block>
                            </value>
                            <value name="VALUE">
                              <block type="math_arithmetic">
                                <field name="OP">MINUS</field>
                                <value name="A">
                                  <block type="variables_valor_guardado">
                                    <field name="VAR">intensidade led</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="math_number">
                                    <field name="NUM">10</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <next>
                              <block type="display_mostrar_valor">
                                <field name="LINHA">1</field>
                                <field name="ALINHAMENTO">LEFT</field>
                                <field name="DISPLAY_TYPE">SMALL</field>
                                <value name="VALOR">
                                  <block type="variables_valor_guardado">
                                    <field name="VAR">intensidade led</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="esperar_segundos">
                                    <value name="TIME">
                                      <block type="math_number">
                                        <field name="NUM">1</field>
                                      </block>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </statement>
                <next>
                  <block type="bloco_desligar_todos_leds"></block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Variação guiada: o buzzer muda de altura e o OLED apresenta a frequência escolhida. -->
  <block type="joystick_controlar_buzzer" x="30" y="30">
    <field name="FREQ_INICIAL">600</field>
    <field name="VOLUME">25</field>
    <field name="DIR_AUMENTAR">RIGHT</field>
    <field name="DIR_DIMINUIR">LEFT</field>
    <next>
      <block type="display_texto">
        <field name="TEXTO">Frequencia:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
        <next>
          <block type="display_mostrar_valor">
            <value name="VALOR"><block type="joystick_frequencia_atual"></block></value>
            <field name="LINHA">2</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

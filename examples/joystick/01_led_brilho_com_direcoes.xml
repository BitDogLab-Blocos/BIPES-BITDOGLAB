<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Descoberta básica: mover o joystick para cima aumenta o brilho do LED vermelho e mover para baixo reduz. -->
  <block type="joystick_controlar_led" x="30" y="30">
    <value name="COR"><block type="colour_red"></block></value>
    <field name="INTENSIDADE_INICIAL">30</field>
    <field name="DIR_AUMENTAR">UP</field>
    <field name="DIR_DIMINUIR">DOWN</field>
    <next>
      <block type="display_texto">
        <field name="TEXTO">Brilho:</field>
        <field name="LINHA">1</field>
        <field name="ALINHAMENTO">LEFT</field>
        <field name="DISPLAY_TYPE">SMALL</field>
        <next>
          <block type="display_mostrar_valor">
            <value name="VALOR"><block type="joystick_intensidade_atual"></block></value>
            <field name="LINHA">1</field>
            <field name="ALINHAMENTO">RIGHT</field>
            <field name="DISPLAY_TYPE">SMALL</field>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Projeto-desafio: combine desenho livre e luz RGB para criar um pequeno estúdio interativo com o joystick. -->
  <block type="joystick_lousa_magica" x="30" y="30">
    <field name="DISPLAY_TYPE">SMALL</field>
    <field name="TAMANHO">2</field>
    <next>
      <block type="joystick_controlar_led">
        <value name="COR"><block type="colour_magenta"></block></value>
        <field name="INTENSIDADE_INICIAL">25</field>
        <field name="DIR_AUMENTAR">RIGHT</field>
        <field name="DIR_DIMINUIR">LEFT</field>
      </block>
    </next>
  </block>
</xml>

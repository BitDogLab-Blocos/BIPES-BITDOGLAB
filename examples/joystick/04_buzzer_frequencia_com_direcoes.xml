<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Descoberta básica: o joystick altera a frequência do buzzer entre 200 e 4000 Hz. -->
  <block type="joystick_controlar_buzzer" x="30" y="30">
    <field name="FREQ_INICIAL">800</field>
    <field name="VOLUME">20</field>
    <field name="DIR_AUMENTAR">UP</field>
    <field name="DIR_DIMINUIR">DOWN</field>
    <next>
      <block type="display_texto">
        <field name="TEXTO">Freq:</field>
        <field name="LINHA">1</field>
        <field name="ALINHAMENTO">LEFT</field>
        <field name="DISPLAY_TYPE">SMALL</field>
        <next>
          <block type="display_mostrar_valor">
            <value name="VALOR"><block type="joystick_frequencia_atual"></block></value>
            <field name="LINHA">1</field>
            <field name="ALINHAMENTO">RIGHT</field>
            <field name="DISPLAY_TYPE">SMALL</field>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

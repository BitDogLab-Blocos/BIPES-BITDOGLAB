<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Jogo de precisão sem delays: mova o player até a região central; OLED, matriz e LED mostram posição, acertos e estado. -->
  <block type="variables_guardar" x="30" y="30">
    <field name="VAR">no_alvo</field>
    <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next><block type="variables_guardar">
      <field name="VAR">acertos</field>
      <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
      <next><block type="joystick_mover_player">
        <field name="DISPLAY_TYPE">SMALL</field><field name="TAMANHO">6</field>
        <next><block type="display_texto">
          <field name="TEXTO">X:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
          <next><block type="display_mostrar_valor">
            <value name="VALOR"><block type="joystick_posicao_x"></block></value><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
            <next><block type="display_texto">
              <field name="TEXTO">Y:</field><field name="LINHA">2</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
              <next><block type="display_mostrar_valor">
                <value name="VALOR"><block type="joystick_posicao_y"></block></value><field name="LINHA">2</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
                <next><block type="display_texto">
                  <field name="TEXTO">Acertos:</field><field name="LINHA">3</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
                  <next><block type="display_mostrar_valor">
                    <value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">acertos</field></block></value><field name="LINHA">3</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
                    <next><block type="controls_ifelse">
                      <value name="IF0"><block type="logic_operation"><field name="OP">AND</field>
                        <value name="A"><block type="logic_operation"><field name="OP">AND</field>
                          <value name="A"><block type="logic_compare"><field name="OP">GTE</field><value name="A"><block type="joystick_posicao_x"></block></value><value name="B"><block type="math_number"><field name="NUM">48</field></block></value></block></value>
                          <value name="B"><block type="logic_compare"><field name="OP">LTE</field><value name="A"><block type="joystick_posicao_x"></block></value><value name="B"><block type="math_number"><field name="NUM">78</field></block></value></block></value>
                        </block></value>
                        <value name="B"><block type="logic_operation"><field name="OP">AND</field>
                          <value name="A"><block type="logic_compare"><field name="OP">GTE</field><value name="A"><block type="joystick_posicao_y"></block></value><value name="B"><block type="math_number"><field name="NUM">20</field></block></value></block></value>
                          <value name="B"><block type="logic_compare"><field name="OP">LTE</field><value name="A"><block type="joystick_posicao_y"></block></value><value name="B"><block type="math_number"><field name="NUM">42</field></block></value></block></value>
                        </block></value>
                      </block></value>
                      <statement name="DO0"><block type="controls_if">
                        <value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">no_alvo</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value>
                        <statement name="DO0"><block type="variables_alterar"><field name="VAR">no_alvo</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">no_alvo</field></block></value><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value><next><block type="variables_adicionar"><field name="VAR">acertos</field><value name="AMOUNT"><block type="math_number"><field name="NUM">1</field></block></value></block></next></block></statement>
                        <next><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_green"></block></value><next><block type="mostrar_emoji"><value name="EMOJI"><block type="emoji_coracao"></block></value><value name="COR"><block type="colour_green"></block></value><field name="BRILHO">20</field><next><block type="display_texto"><field name="TEXTO">ALVO CERTO!</field><field name="LINHA">5</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field></block></next></block></next></block></next>
                      </block></statement>
                      <statement name="ELSE"><block type="variables_alterar"><field name="VAR">no_alvo</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">no_alvo</field></block></value><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value><next><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_blue"></block></value><next><block type="mostrar_emoji"><value name="EMOJI"><block type="emoji_seta_cima"></block></value><value name="COR"><block type="colour_blue"></block></value><field name="BRILHO">20</field><next><block type="display_texto"><field name="TEXTO">Ache o alvo</field><field name="LINHA">5</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field></block></next></block></next></block></next></block></statement>
                    </block></next>
                  </block></next>
                </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

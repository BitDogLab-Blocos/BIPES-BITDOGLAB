<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Projeto de jogo: A soma, B retira, C zera; OLED e matriz apresentam o placar de 0 a 3. -->
  <block type="variables_guardar" x="30" y="30">
    <field name="VAR">pontos</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next><block type="botao_se_apertado">
      <field name="BOTAO">A</field>
      <statement name="DO"><block type="controls_if">
        <value name="IF0"><block type="logic_compare"><field name="OP">LT</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">pontos</field></block></value><value name="B"><block type="math_number"><field name="NUM">3</field></block></value></block></value>
        <statement name="DO0"><block type="variables_adicionar"><field name="VAR">pontos</field><value name="AMOUNT"><block type="math_number"><field name="NUM">1</field></block></value><next><block type="bipe_curto"><field name="VOLUME">25</field><next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">250</field></block></value></block></next></block></next></block></statement>
      </block></statement>
      <next><block type="botao_se_apertado">
        <field name="BOTAO">B</field>
        <statement name="DO"><block type="controls_if">
          <value name="IF0"><block type="logic_compare"><field name="OP">GT</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">pontos</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value>
          <statement name="DO0"><block type="variables_tirar"><field name="VAR">pontos</field><value name="AMOUNT"><block type="math_number"><field name="NUM">1</field></block></value></block></statement>
        </block></statement>
        <next><block type="botao_se_apertado">
          <field name="BOTAO">C</field>
          <statement name="DO"><block type="variables_alterar"><field name="VAR">pontos</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">pontos</field></block></value><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value></block></statement>
          <next><block type="display_texto">
            <field name="TEXTO">Pontos:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
            <next><block type="display_mostrar_valor">
              <value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">pontos</field></block></value><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
              <next><block type="controls_if">
                <value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">pontos</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value>
                <statement name="DO0"><block type="mostrar_numero_matriz"><value name="NUMERO"><block type="numero_matriz_0"></block></value><value name="COR"><block type="colour_cyan"></block></value><field name="BRILHO">30</field></block></statement>
                <next><block type="controls_if">
                  <value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">pontos</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value>
                  <statement name="DO0"><block type="mostrar_numero_matriz"><value name="NUMERO"><block type="numero_matriz_1"></block></value><value name="COR"><block type="colour_green"></block></value><field name="BRILHO">30</field></block></statement>
                  <next><block type="controls_if">
                    <value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">pontos</field></block></value><value name="B"><block type="math_number"><field name="NUM">2</field></block></value></block></value>
                    <statement name="DO0"><block type="mostrar_numero_matriz"><value name="NUMERO"><block type="numero_matriz_2"></block></value><value name="COR"><block type="colour_yellow"></block></value><field name="BRILHO">30</field></block></statement>
                    <next><block type="controls_if">
                      <value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">pontos</field></block></value><value name="B"><block type="math_number"><field name="NUM">3</field></block></value></block></value>
                      <statement name="DO0"><block type="mostrar_numero_matriz"><value name="NUMERO"><block type="numero_matriz_3"></block></value><value name="COR"><block type="colour_red"></block></value><field name="BRILHO">30</field></block></statement>
                      <next><block type="display_dashboard_matriz">
                        <field name="INFO_LINHA1">NONE</field><field name="ALIGN_1">LEFT</field>
                        <field name="INFO_LINHA2">STATUS</field><field name="ALIGN_2">LEFT</field>
                        <field name="INFO_LINHA3">DESENHO</field><field name="ALIGN_3">CENTER</field>
                        <field name="INFO_LINHA4">COR_NOME</field><field name="ALIGN_4">RIGHT</field>
                        <field name="INFO_LINHA5">BRILHO</field><field name="ALIGN_5">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
                      </block></next>
                    </block></next>
                  </block></next>
                </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

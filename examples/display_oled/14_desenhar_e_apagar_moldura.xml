<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Experimento visual: mantém a moldura por dois segundos, apaga somente a borda e repete. -->
  <block type="display_criar_borda" x="30" y="30">
    <field name="DISPLAY_TYPE">SMALL</field>
    <next><block type="display_texto">
      <field name="TEXTO">Observe a borda</field><field name="LINHA">3</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field>
      <next><block type="esperar_segundos">
        <value name="TIME"><block type="math_number"><field name="NUM">2</field></block></value>
        <next><block type="display_limpar_borda">
          <field name="DISPLAY_TYPE">SMALL</field>
          <next><block type="esperar_segundos">
            <value name="TIME"><block type="math_number"><field name="NUM">2</field></block></value>
          </block></next>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Console multimodal: A troca entre luz, cursor e som; B volta ao modo zero; OLED explica e mostra o valor de cada periférico. -->
  <block type="variables_guardar" x="30" y="30">
    <field name="VAR">modo_console</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next><block type="botao_se_apertado"><field name="BOTAO">A</field>
      <statement name="DO"><block type="variables_alterar"><field name="VAR">modo_console</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">modo_console</field></block></value><value name="VALUE"><block type="math_modulo"><value name="DIVIDEND"><block type="math_arithmetic"><field name="OP">ADD</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">modo_console</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value><value name="DIVISOR"><block type="math_number"><field name="NUM">3</field></block></value></block></value><next><block type="bipe_curto"><field name="VOLUME">20</field></block></next></block></statement>
      <next><block type="botao_se_apertado"><field name="BOTAO">B</field>
        <statement name="DO"><block type="variables_alterar"><field name="VAR">modo_console</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">modo_console</field></block></value><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value><next><block type="bloco_desligar_todos_leds"><next><block type="desligar_matriz"></block></next></block></next></block></statement>
        <next><block type="display_texto"><field name="TEXTO">Console modos</field><field name="LINHA">1</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field>
          <next><block type="display_texto"><field name="TEXTO">Modo:</field><field name="LINHA">2</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
            <next><block type="display_mostrar_valor"><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">modo_console</field></block></value><field name="LINHA">2</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
              <next><block type="display_texto"><field name="TEXTO">Valor atual:</field><field name="LINHA">3</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
                <next><block type="display_texto"><field name="TEXTO">A troca B zera</field><field name="LINHA">5</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field>
                  <next><block type="controls_if"><value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">modo_console</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value>
                  <statement name="DO0"><block type="desligar_matriz"><next><block type="joystick_controlar_led"><value name="COR"><block type="colour_cyan"></block></value><field name="INTENSIDADE_INICIAL">30</field><field name="DIR_AUMENTAR">RIGHT</field><field name="DIR_DIMINUIR">LEFT</field><next><block type="display_mostrar_valor"><value name="VALOR"><block type="joystick_intensidade_atual"></block></value><field name="LINHA">4</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field></block></next></block></next></block></statement>
                  <next><block type="controls_if"><value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">modo_console</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value>
                    <statement name="DO0"><block type="bloco_desligar_todos_leds"><next><block type="joystick_cursor_matriz"><value name="COR"><block type="colour_blue"></block></value><field name="BRILHO">20</field><field name="LINHA_INICIAL">2</field><field name="COLUNA_INICIAL">2</field><next><block type="display_texto"><field name="TEXTO">Mova o ponto</field><field name="LINHA">4</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field></block></next></block></next></block></statement>
                    <next><block type="controls_if"><value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">modo_console</field></block></value><value name="B"><block type="math_number"><field name="NUM">2</field></block></value></block></value>
                      <statement name="DO0"><block type="microfone_vu_meter"><value name="COR"><block type="colour_orange"></block></value><field name="BRILHO">20</field><next><block type="controls_ifelse"><value name="IF0"><block type="logic_compare"><field name="OP">GTE</field><value name="A"><block type="microfone_nivel_atual"></block></value><value name="B"><block type="math_number"><field name="NUM">4</field></block></value></block></value><statement name="DO0"><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_red"></block></value></block></statement><statement name="ELSE"><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_green"></block></value></block></statement><next><block type="display_mostrar_valor"><value name="VALOR"><block type="microfone_nivel_atual"></block></value><field name="LINHA">4</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field></block></next></block></next></block></statement>
                    </block></next>
                  </block></next>
                </block></next>
              </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

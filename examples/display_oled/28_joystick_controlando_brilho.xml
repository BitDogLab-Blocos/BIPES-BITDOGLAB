<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Controle contínuo: o joystick muda o brilho do LED verde e o OLED mostra valor e estado. -->
  <block type="joystick_controlar_led" x="30" y="30">
    <value name="COR"><block type="colour_green"></block></value>
    <field name="INTENSIDADE_INICIAL">30</field><field name="DIR_AUMENTAR">UP</field><field name="DIR_DIMINUIR">DOWN</field>
    <next><block type="display_texto">
      <field name="TEXTO">Brilho:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
      <next><block type="display_mostrar_valor">
        <value name="VALOR"><block type="joystick_intensidade_atual"></block></value>
        <field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
        <next><block type="display_mostrar_estado_led">
          <value name="COLOUR"><block type="colour_green"></block></value>
          <field name="LINHA">2</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

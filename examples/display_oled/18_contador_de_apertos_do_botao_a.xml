<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Contagem autônoma: mostra se A está pressionado e quantas vezes ele foi acionado. -->
  <block type="display_texto" x="30" y="30">
    <field name="TEXTO">Contador A</field><field name="LINHA">1</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field>
    <next><block type="display_mostrar_estado_botao">
      <field name="BOTAO">A</field><field name="LINHA">2</field><field name="ALINHAMENTO">LEFT</field>
      <field name="MOSTRAR_CONTAGEM">TRUE</field><field name="LINHA_CONTAGEM">3</field><field name="ALINHAMENTO_CONTAGEM">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
    </block></next>
  </block>
</xml>

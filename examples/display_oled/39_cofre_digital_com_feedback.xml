<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Cofre educativo: A digita 1, B digita 2, C confirma 121 e o joystick zera; OLED, matriz, LED e som dão feedback. -->
  <block type="variables_guardar" x="30" y="30">
    <field name="VAR">codigo_cofre</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next><block type="variables_guardar">
      <field name="VAR">erros_cofre</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
      <next><block type="botao_se_apertado"><field name="BOTAO">A</field>
        <statement name="DO"><block type="variables_alterar"><field name="VAR">codigo_cofre</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">codigo_cofre</field></block></value><value name="VALUE"><block type="math_modulo"><value name="DIVIDEND"><block type="math_arithmetic"><field name="OP">ADD</field><value name="A"><block type="math_arithmetic"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">codigo_cofre</field></block></value><value name="B"><block type="math_number"><field name="NUM">10</field></block></value></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value><value name="DIVISOR"><block type="math_number"><field name="NUM">1000</field></block></value></block></value><next><block type="mostrar_numero_matriz"><value name="NUMERO"><block type="numero_matriz_1"></block></value><value name="COR"><block type="colour_skyblue"></block></value><field name="BRILHO">20</field></block></next></block></statement>
        <next><block type="botao_se_apertado"><field name="BOTAO">B</field>
          <statement name="DO"><block type="variables_alterar"><field name="VAR">codigo_cofre</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">codigo_cofre</field></block></value><value name="VALUE"><block type="math_modulo"><value name="DIVIDEND"><block type="math_arithmetic"><field name="OP">ADD</field><value name="A"><block type="math_arithmetic"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">codigo_cofre</field></block></value><value name="B"><block type="math_number"><field name="NUM">10</field></block></value></block></value><value name="B"><block type="math_number"><field name="NUM">2</field></block></value></block></value><value name="DIVISOR"><block type="math_number"><field name="NUM">1000</field></block></value></block></value><next><block type="mostrar_numero_matriz"><value name="NUMERO"><block type="numero_matriz_2"></block></value><value name="COR"><block type="colour_orange"></block></value><field name="BRILHO">20</field></block></next></block></statement>
          <next><block type="botao_se_apertado"><field name="BOTAO">C</field>
            <statement name="DO"><block type="controls_ifelse"><value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">codigo_cofre</field></block></value><value name="B"><block type="math_number"><field name="NUM">121</field></block></value></block></value>
              <statement name="DO0"><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_green"></block></value><next><block type="mostrar_emoji"><value name="EMOJI"><block type="emoji_rosto_feliz"></block></value><value name="COR"><block type="colour_green"></block></value><field name="BRILHO">20</field><next><block type="som_de_sucesso"><field name="VOLUME">25</field><next><block type="display_texto"><field name="TEXTO">Acesso liberado</field><field name="LINHA">4</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field></block></next></block></next></block></next></block></statement>
              <statement name="ELSE"><block type="variables_adicionar"><field name="VAR">erros_cofre</field><value name="AMOUNT"><block type="math_number"><field name="NUM">1</field></block></value><next><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_red"></block></value><next><block type="mostrar_emoji"><value name="EMOJI"><block type="emoji_fantasma"></block></value><value name="COR"><block type="colour_red"></block></value><field name="BRILHO">20</field><next><block type="som_de_falha"><field name="VOLUME">25</field><next><block type="display_texto"><field name="TEXTO">Codigo errado</field><field name="LINHA">4</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field></block></next></block></next></block></next></block></next></block></statement>
              <next><block type="variables_alterar"><field name="VAR">codigo_cofre</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">codigo_cofre</field></block></value><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value></block></next>
            </block></statement>
            <next><block type="botao_se_apertado"><field name="BOTAO">JOYSTICK</field>
              <statement name="DO"><block type="variables_alterar"><field name="VAR">codigo_cofre</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">codigo_cofre</field></block></value><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value><next><block type="variables_alterar"><field name="VAR">erros_cofre</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">erros_cofre</field></block></value><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value><next><block type="bloco_desligar_todos_leds"><next><block type="desligar_matriz"><next><block type="display_texto"><field name="TEXTO">Cofre zerado</field><field name="LINHA">4</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field></block></next></block></next></block></next></block></next></block></statement>
              <next><block type="display_texto"><field name="TEXTO">Cofre digital</field><field name="LINHA">1</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field>
                <next><block type="display_texto"><field name="TEXTO">Codigo:</field><field name="LINHA">2</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
                  <next><block type="display_mostrar_valor"><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">codigo_cofre</field></block></value><field name="LINHA">2</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
                    <next><block type="display_texto"><field name="TEXTO">Erros:</field><field name="LINHA">3</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
                      <next><block type="display_mostrar_valor"><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">erros_cofre</field></block></value><field name="LINHA">3</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
                        <next><block type="display_texto"><field name="TEXTO">A1 B2 C valida</field><field name="LINHA">5</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field></block></next>
                      </block></next>
                    </block></next>
                  </block></next>
                </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

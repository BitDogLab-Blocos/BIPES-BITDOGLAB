<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Interface de movimento: o joystick move o player e as coordenadas aparecem sem atrasar a tela. -->
  <block type="joystick_mover_player" x="30" y="30">
    <field name="DISPLAY_TYPE">SMALL</field><field name="TAMANHO">5</field>
    <next><block type="display_texto">
      <field name="TEXTO">X:</field><field name="LINHA">4</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
      <next><block type="display_mostrar_valor">
        <value name="VALOR"><block type="joystick_posicao_x"></block></value>
        <field name="LINHA">4</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
        <next><block type="display_texto">
          <field name="TEXTO">Y:</field><field name="LINHA">5</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
          <next><block type="display_mostrar_valor">
            <value name="VALOR"><block type="joystick_posicao_y"></block></value>
            <field name="LINHA">5</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
          </block></next>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Painel duplo: A e B contam separadamente; apertar o joystick zera A, B e C juntos. -->
  <block type="display_mostrar_estado_botao" x="30" y="30">
    <field name="BOTAO">A</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field>
    <field name="MOSTRAR_CONTAGEM">TRUE</field><field name="LINHA_CONTAGEM">2</field><field name="ALINHAMENTO_CONTAGEM">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
    <next><block type="display_mostrar_estado_botao">
      <field name="BOTAO">B</field><field name="LINHA">3</field><field name="ALINHAMENTO">LEFT</field>
      <field name="MOSTRAR_CONTAGEM">TRUE</field><field name="LINHA_CONTAGEM">4</field><field name="ALINHAMENTO_CONTAGEM">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
      <next><block type="botao_se_apertado">
        <field name="BOTAO">JOYSTICK</field>
        <statement name="DO"><block type="display_resetar_contagem"><field name="BOTAO">ALL</field></block></statement>
        <next><block type="display_texto">
          <field name="TEXTO">Joy zera todos</field><field name="LINHA">5</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

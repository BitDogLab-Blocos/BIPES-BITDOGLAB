<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Central de ruído: A/B ajustam o limite, C zera alertas; microfone, matriz, LED, buzzer e OLED trabalham juntos. -->
  <block type="variables_guardar" x="30" y="30">
    <field name="VAR">limite_som</field><value name="VALUE"><block type="math_number"><field name="NUM">4</field></block></value>
    <next><block type="variables_guardar">
      <field name="VAR">alertas_som</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
      <next><block type="variables_guardar">
        <field name="VAR">alerta_ativo</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
        <next><block type="botao_se_apertado">
          <field name="BOTAO">A</field><statement name="DO"><block type="controls_if"><value name="IF0"><block type="logic_compare"><field name="OP">LT</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">limite_som</field></block></value><value name="B"><block type="math_number"><field name="NUM">5</field></block></value></block></value><statement name="DO0"><block type="variables_adicionar"><field name="VAR">limite_som</field><value name="AMOUNT"><block type="math_number"><field name="NUM">1</field></block></value></block></statement></block></statement>
          <next><block type="botao_se_apertado">
            <field name="BOTAO">B</field><statement name="DO"><block type="controls_if"><value name="IF0"><block type="logic_compare"><field name="OP">GT</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">limite_som</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value><statement name="DO0"><block type="variables_tirar"><field name="VAR">limite_som</field><value name="AMOUNT"><block type="math_number"><field name="NUM">1</field></block></value></block></statement></block></statement>
            <next><block type="botao_se_apertado">
              <field name="BOTAO">C</field><statement name="DO"><block type="variables_alterar"><field name="VAR">alertas_som</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">alertas_som</field></block></value><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value><next><block type="variables_alterar"><field name="VAR">alerta_ativo</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">alerta_ativo</field></block></value><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value></block></next></block></statement>
              <next><block type="microfone_vu_meter">
                <value name="COR"><block type="colour_orange"></block></value><field name="BRILHO">20</field>
                <next><block type="display_texto"><field name="TEXTO">Nivel:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
                  <next><block type="display_mostrar_valor"><value name="VALOR"><block type="microfone_nivel_atual"></block></value><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
                    <next><block type="display_texto"><field name="TEXTO">Limite:</field><field name="LINHA">2</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
                      <next><block type="display_mostrar_valor"><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">limite_som</field></block></value><field name="LINHA">2</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
                        <next><block type="display_texto"><field name="TEXTO">Alertas:</field><field name="LINHA">3</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
                          <next><block type="display_mostrar_valor"><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">alertas_som</field></block></value><field name="LINHA">3</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
                            <next><block type="display_texto"><field name="TEXTO">A+ B- C zera</field><field name="LINHA">5</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field>
                              <next><block type="controls_if">
                                <value name="IF0"><block type="logic_operation"><field name="OP">AND</field><value name="A"><block type="logic_compare"><field name="OP">GTE</field><value name="A"><block type="microfone_nivel_atual"></block></value><value name="B"><block type="variables_valor_guardado"><field name="VAR">limite_som</field></block></value></block></value><value name="B"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">alerta_ativo</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value></block></value>
                                <statement name="DO0"><block type="variables_alterar"><field name="VAR">alerta_ativo</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">alerta_ativo</field></block></value><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value><next><block type="variables_adicionar"><field name="VAR">alertas_som</field><value name="AMOUNT"><block type="math_number"><field name="NUM">1</field></block></value><next><block type="bipe_duplo"><field name="VOLUME">25</field></block></next></block></next></block></statement>
                                <next><block type="controls_if"><value name="IF0"><block type="logic_operation"><field name="OP">AND</field><value name="A"><block type="logic_compare"><field name="OP">LT</field><value name="A"><block type="microfone_nivel_atual"></block></value><value name="B"><block type="variables_valor_guardado"><field name="VAR">limite_som</field></block></value></block></value><value name="B"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">alerta_ativo</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value></block></value><statement name="DO0"><block type="variables_alterar"><field name="VAR">alerta_ativo</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">alerta_ativo</field></block></value><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value></block></statement>
                                  <next><block type="controls_ifelse"><value name="IF0"><block type="logic_compare"><field name="OP">GTE</field><value name="A"><block type="microfone_nivel_atual"></block></value><value name="B"><block type="variables_valor_guardado"><field name="VAR">limite_som</field></block></value></block></value><statement name="DO0"><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_red"></block></value></block></statement><statement name="ELSE"><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_green"></block></value></block></statement></block></next>
                                </block></next>
                              </block></next>
                            </block></next>
                          </block></next>
                        </block></next>
                      </block></next>
                    </block></next>
                  </block></next>
                </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

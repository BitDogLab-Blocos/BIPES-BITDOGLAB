<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Desafio de tempo: A inicia uma rodada, B para e C zera; cronômetro, OLED, matriz, LED e som registram o treino. -->
  <block type="variables_guardar" x="30" y="30">
    <field name="VAR">rodadas_tempo</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next><block type="variables_guardar">
      <field name="VAR">treino_ativo</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
      <next><block type="botao_se_apertado"><field name="BOTAO">A</field>
        <statement name="DO"><block type="controls_if"><value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">treino_ativo</field></block></value><value name="B"><block type="math_number"><field name="NUM">0</field></block></value></block></value>
          <statement name="DO0"><block type="variables_alterar"><field name="VAR">treino_ativo</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">treino_ativo</field></block></value><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value><next><block type="variables_adicionar"><field name="VAR">rodadas_tempo</field><value name="AMOUNT"><block type="math_number"><field name="NUM">1</field></block></value><next><block type="cronometro_reiniciar"><field name="NAME">desafio</field><next><block type="cronometro_iniciar"><field name="NAME">desafio</field><next><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_blue"></block></value><next><block type="mostrar_emoji"><value name="EMOJI"><block type="emoji_seta_cima"></block></value><value name="COR"><block type="colour_blue"></block></value><field name="BRILHO">20</field></block></next></block></next></block></next></block></next></block></next></block></statement>
        </block></statement>
        <next><block type="botao_se_apertado"><field name="BOTAO">B</field>
          <statement name="DO"><block type="controls_if"><value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">treino_ativo</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value>
            <statement name="DO0"><block type="cronometro_parar"><field name="NAME">desafio</field><next><block type="variables_alterar"><field name="VAR">treino_ativo</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">treino_ativo</field></block></value><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value><next><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_green"></block></value><next><block type="mostrar_emoji"><value name="EMOJI"><block type="emoji_rosto_feliz"></block></value><value name="COR"><block type="colour_green"></block></value><field name="BRILHO">20</field><next><block type="som_de_sucesso"><field name="VOLUME">25</field></block></next></block></next></block></next></block></next></block></statement>
          </block></statement>
          <next><block type="botao_se_apertado"><field name="BOTAO">C</field>
            <statement name="DO"><block type="cronometro_reiniciar"><field name="NAME">desafio</field><next><block type="variables_alterar"><field name="VAR">treino_ativo</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">treino_ativo</field></block></value><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value><next><block type="variables_alterar"><field name="VAR">rodadas_tempo</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">rodadas_tempo</field></block></value><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value><next><block type="bloco_desligar_todos_leds"><next><block type="desligar_matriz"></block></next></block></next></block></next></block></next></block></statement>
            <next><block type="display_texto"><field name="TEXTO">Rodadas:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
              <next><block type="display_mostrar_valor"><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">rodadas_tempo</field></block></value><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
                <next><block type="display_texto"><field name="TEXTO">Ativo:</field><field name="LINHA">2</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
                  <next><block type="display_mostrar_valor"><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">treino_ativo</field></block></value><field name="LINHA">2</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
                    <next><block type="cronometro_mostrar"><field name="NAME">desafio</field><field name="LINE">3</field><field name="ALIGN">CENTER</field><field name="FORMAT">MS_MILLI</field><field name="DISPLAY_TYPE">SMALL</field>
                      <next><block type="display_texto"><field name="TEXTO">A inicia B para</field><field name="LINHA">4</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field>
                        <next><block type="display_texto"><field name="TEXTO">C zera treino</field><field name="LINHA">5</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field></block></next>
                      </block></next>
                    </block></next>
                  </block></next>
                </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Variável visível: guarda 42 pontos e mostra o valor à direita do rótulo. -->
  <block type="variables_guardar" x="30" y="30">
    <field name="VAR">pontos</field>
    <value name="VALUE"><block type="math_number"><field name="NUM">42</field></block></value>
    <next><block type="display_texto">
      <field name="TEXTO">Pontos:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
      <next><block type="display_mostrar_valor">
        <value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">pontos</field></block></value>
        <field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
      </block></next>
    </block></next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Projeto desafio: o contato 0 abre a cancela e o contato 1 fecha. O servo esta na 2, o LED vermelho externo na 3 e os LEDs da placa mostram o estado. -->
  <block type="external_contact_prepare" x="20" y="20">
    <field name="COMMON">GND</field>
    <next>
      <block type="external_contact_when_closed"><field name="DIG">0</field>
        <statement name="DO">
          <block type="servo_mover"><field name="DIG">2</field><field name="ANGLE">90</field>
            <next>
              <block type="led_externo_ligar"><field name="CHANNEL">R</field><field name="DIG">3</field>
                <next>
                  <block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_green"></block></value>
                    <next><block type="som_de_sucesso"><field name="VOLUME">25</field><next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">500</field></block></value></block></next></block></next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="external_contact_when_closed"><field name="DIG">1</field>
            <statement name="DO">
              <block type="servo_mover"><field name="DIG">2</field><field name="ANGLE">0</field>
                <next>
                  <block type="led_externo_desligar"><field name="CHANNEL">R</field><field name="DIG">3</field>
                    <next>
                      <block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_red"></block></value>
                        <next><block type="som_de_falha"><field name="VOLUME">25</field><next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">500</field></block></value></block></next></block></next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

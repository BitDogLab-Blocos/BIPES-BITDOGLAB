<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- O contato na Conexao 1 seleciona o estado do KY-016: vermelho na Conexao 2 ou verde na Conexao 3. -->
  <block type="external_contact_prepare" x="20" y="20">
    <field name="COMMON">3V3</field>
    <next>
      <block type="controls_ifelse">
        <value name="IF0"><block type="external_contact_is_closed"><field name="DIG">1</field></block></value>
        <statement name="DO0"><block type="led_externo_ligar"><field name="CHANNEL">R</field><field name="DIG">2</field></block></statement>
        <statement name="ELSE"><block type="led_externo_ligar"><field name="CHANNEL">G</field><field name="DIG">3</field></block></statement>
      </block>
    </next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Um toque na Conexao 0 toca um bipe uma vez; separar e encostar de novo repete a acao. -->
  <block type="external_contact_prepare" x="20" y="20">
    <field name="COMMON">GND</field>
    <next>
      <block type="external_contact_when_closed">
        <field name="DIG">0</field>
        <statement name="DO">
          <block type="bipe_curto">
            <field name="VOLUME">30</field>
            <next>
              <block type="esperar_milisegundos">
                <value name="TIME"><block type="math_number"><field name="NUM">300</field></block></value>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Cada toque na Conexao 0 aumenta a memoria, mostra o total no OLED e toca uma nota. Ao chegar a 3, a Matriz confirma a meta. -->
  <block type="variables_guardar" x="20" y="20">
    <field name="VAR">toques</field>
    <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next>
      <block type="external_contact_prepare"><field name="COMMON">GND</field>
        <next>
          <block type="external_contact_when_closed"><field name="DIG">0</field>
            <statement name="DO">
              <block type="variables_adicionar"><field name="VAR">toques</field><value name="AMOUNT"><block type="math_number"><field name="NUM">1</field></block></value>
                <next>
                  <block type="display_limpar"><field name="DISPLAY_TYPE">SMALL</field>
                    <next>
                      <block type="display_texto"><field name="TEXTO">Toques:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
                        <next>
                          <block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">toques</field></block></value>
                            <next>
                              <block type="tocar_nota"><value name="NOTA"><block type="nota_do"></block></value><field name="OCTAVE">4</field><field name="VOLUME">30</field><field name="DURATION">250</field>
                                <next>
                                  <block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">400</field></block></value>
                                    <next>
                                      <block type="controls_if">
                                        <value name="IF0"><block type="logic_compare"><field name="OP">GTE</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">toques</field></block></value><value name="B"><block type="math_number"><field name="NUM">3</field></block></value></block></value>
                                        <statement name="DO0"><block type="mostrar_numero_matriz"><value name="NUMERO"><block type="numero_matriz_3"></block></value><value name="COR"><block type="colour_green"></block></value><field name="BRILHO">30</field><next><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_green"></block></value></block></next></block></statement>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Cada toque na Conexao 2 toca a nota Mi e espera um pouco antes de aceitar outro toque. -->
  <block type="external_contact_prepare" x="20" y="20">
    <field name="COMMON">GND</field>
    <next>
      <block type="external_contact_when_closed">
        <field name="DIG">2</field>
        <statement name="DO">
          <block type="tocar_nota">
            <value name="NOTA"><block type="nota_mi"></block></value>
            <field name="OCTAVE">4</field><field name="VOLUME">30</field><field name="DURATION">350</field>
            <next>
              <block type="esperar_milisegundos">
                <value name="TIME"><block type="math_number"><field name="NUM">450</field></block></value>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>

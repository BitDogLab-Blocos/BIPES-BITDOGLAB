<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- A logica NAO transforma sem contato em alerta: a Matriz mostra um fantasma e o LED amarelo acende. Ao encostar, tudo e limpo. -->
  <block type="external_contact_prepare" x="20" y="20">
    <field name="COMMON">GND</field>
    <next>
      <block type="controls_ifelse">
        <value name="IF0"><block type="logic_negate"><value name="BOOL"><block type="external_contact_is_closed"><field name="DIG">0</field></block></value></block></value>
        <statement name="DO0"><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_yellow"></block></value><next><block type="mostrar_emoji"><value name="EMOJI"><block type="emoji_fantasma"></block></value><value name="COR"><block type="colour_red"></block></value><field name="BRILHO">30</field></block></next></block></statement>
        <statement name="ELSE"><block type="bloco_desligar_todos_leds"><next><block type="desligar_matriz"></block></next></block></statement>
        <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">500</field></block></value></block></next>
      </block>
    </next>
  </block>
</xml>

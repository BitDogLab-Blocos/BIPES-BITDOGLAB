<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Um toque na Conexao 0 faz o KY-016 alternar vermelho e azul; os fios usam 1 e 2. -->
  <block type="external_contact_prepare" x="20" y="20">
    <field name="COMMON">GND</field>
    <next>
      <block type="external_contact_when_closed"><field name="DIG">0</field>
        <statement name="DO">
          <block type="led_externo_criar_animacao">
            <mutation steps="[&quot;action&quot;,&quot;time&quot;,&quot;action&quot;,&quot;time&quot;]"></mutation>
            <statement name="STEP0"><block type="led_externo_ligar"><field name="CHANNEL">R</field><field name="DIG">1</field></block></statement>
            <value name="TIME1"><block type="tempo_segundos"><field name="NUM">1</field></block></value>
            <statement name="STEP2"><block type="led_externo_ligar"><field name="CHANNEL">B</field><field name="DIG">2</field></block></statement>
            <value name="TIME3"><block type="tempo_segundos"><field name="NUM">1</field></block></value>
            <next>
              <block type="led_externo_desligar"><field name="CHANNEL">R</field><field name="DIG">1</field>
                <next>
                  <block type="led_externo_desligar"><field name="CHANNEL">B</field><field name="DIG">2</field></block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>

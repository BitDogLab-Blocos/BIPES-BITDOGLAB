<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Mantenha a carinha feliz deixando o ambiente silencioso. -->
  <block x="30" y="30" type="microfone_vu_meter">
    <field name="BRILHO">10</field>
    <value name="COR">
      <block type="colour_blue">
      </block>
    </value>
    <next>
      <block type="controls_ifelse">
        <value name="IF0">
          <block type="logic_compare">
            <field name="OP">LTE</field>
            <value name="A">
              <block type="microfone_nivel_atual">
              </block>
            </value>
            <value name="B">
              <block type="math_number">
                <field name="NUM">1</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="mostrar_emoji">
            <field name="BRILHO">25</field>
            <value name="EMOJI">
              <block type="emoji_rosto_feliz">
              </block>
            </value>
            <value name="COR">
              <block type="colour_green">
              </block>
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="mostrar_emoji">
            <field name="BRILHO">25</field>
            <value name="EMOJI">
              <block type="emoji_rosto_triste">
              </block>
            </value>
            <value name="COR">
              <block type="colour_red">
              </block>
            </value>
          </block>
        </statement>
        <next>
          <block type="display_limpar">
            <field name="DISPLAY_TYPE">SMALL</field>
            <next>
              <block type="display_texto">
                <field name="TEXTO">Desafio silencio</field>
                <field name="LINHA">1</field>
                <field name="ALINHAMENTO">LEFT</field>
                <field name="DISPLAY_TYPE">SMALL</field>
                <next>
                  <block type="display_texto">
                    <field name="TEXTO">Nivel:</field>
                    <field name="LINHA">3</field>
                    <field name="ALINHAMENTO">LEFT</field>
                    <field name="DISPLAY_TYPE">SMALL</field>
                    <next>
                      <block type="display_mostrar_valor">
                        <field name="LINHA">3</field>
                        <field name="ALINHAMENTO">RIGHT</field>
                        <field name="DISPLAY_TYPE">SMALL</field>
                        <value name="VALOR">
                          <block type="microfone_nivel_atual">
                          </block>
                        </value>
                        <next>
                          <block type="esperar_milisegundos">
                            <value name="TIME">
                              <block type="math_number">
                                <field name="NUM">100</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

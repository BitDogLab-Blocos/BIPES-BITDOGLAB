<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Primeiro movimento gradual: a repetição executa uma subida completa de 0 até 60 graus. -->
  <block type="controls_repeat_simple" x="20" y="20">
    <field name="TIMES">1</field>
    <statement name="DO">
      <block type="servo_subir_gradualmente">
        <field name="DIG">0</field><field name="START">0</field><field name="TARGET">60</field><field name="STEP">15</field><field name="PAUSE">1</field>
      </block>
    </statement>
  </block>
</xml>

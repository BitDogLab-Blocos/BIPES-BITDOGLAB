<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Verde sinaliza a partida e vermelho sinaliza a chegada. -->
  <block type="robo_setas_iniciar" x="30" y="30">
    <next>
      <block type="bloco_ligar_led">
        <value name="COLOUR">
          <block type="colour_green" />
        </value>
        <next>
          <block type="robo_setas_frente">
            <next>
              <block type="robo_setas_direita">
                <next>
                  <block type="bloco_ligar_led">
                    <value name="COLOUR">
                      <block type="colour_red" />
                    </value>
                    <next>
                      <block type="robo_setas_finalizar" />
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

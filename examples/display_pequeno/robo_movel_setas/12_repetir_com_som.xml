<?xml version="1.0" encoding="utf-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Siga duas vezes o caminho cima e direita. Um bipe marca cada ponto de checagem; o sorriso azul e o troféu sinalizam a chegada. -->
  <block type="robo_setas_iniciar" x="30" y="30">
    <next>
      <block type="robo_setas_frente">
        <next>
          <block type="robo_setas_bipe">
            <next>
              <block type="robo_setas_direita">
                <next>
                  <block type="robo_setas_frente">
                    <next>
                      <block type="robo_setas_bipe">
                        <next>
                          <block type="robo_setas_direita">
                            <next>
                              <block type="robo_setas_rosto_feliz">
                                <field name="COR">#3b82f6</field>
                                <next>
                                  <block type="robo_setas_sucesso">
                                    <next>
                                      <block type="robo_setas_finalizar" />
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

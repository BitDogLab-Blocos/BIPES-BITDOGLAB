<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Missão com sinal de partida, percurso, matriz e som de chegada. -->
  <block type="robo_setas_iniciar" x="30" y="30">
    <next>
      <block type="bipe_curto">
        <field name="VOLUME">35</field>
        <next>
          <block type="mostrar_emoji">
            <field name="BRILHO">25</field>
            <value name="EMOJI">
              <block type="emoji_seta_cima" />
            </value>
            <value name="COR">
              <block type="colour_blue" />
            </value>
            <next>
              <block type="robo_setas_frente">
                <next>
                  <block type="robo_setas_direita">
                    <next>
                      <block type="robo_setas_frente">
                        <next>
                          <block type="mostrar_emoji">
                            <field name="BRILHO">25</field>
                            <value name="EMOJI">
                              <block type="emoji_rosto_feliz" />
                            </value>
                            <value name="COR">
                              <block type="colour_green" />
                            </value>
                            <next>
                              <block type="som_de_sucesso">
                                <field name="VOLUME">35</field>
                                <next>
                                  <block type="robo_setas_finalizar" />
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

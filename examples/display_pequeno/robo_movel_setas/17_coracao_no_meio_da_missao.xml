<?xml version="1.0" encoding="utf-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Suba duas casas para buscar o coração vermelho. Um bipe marca o encontro; volte duas casas e celebre a entrega com sorriso verde e troféu. -->
  <block type="robo_setas_iniciar" x="30" y="30">
    <next>
      <block type="robo_setas_frente">
        <next>
          <block type="robo_setas_frente">
            <next>
              <block type="robo_setas_coracao">
                <field name="COR">#ef4444</field>
                <next>
                  <block type="robo_setas_bipe">
                    <next>
                      <block type="robo_setas_voltar">
                        <next>
                          <block type="robo_setas_voltar">
                            <next>
                              <block type="robo_setas_rosto_feliz">
                                <field name="COR">#22c55e</field>
                                <next>
                                  <block type="robo_setas_sucesso">
                                    <next>
                                      <block type="robo_setas_finalizar" />
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- A Matriz mostra surpresa durante o movimento e um rosto feliz quando o sensor para. -->
  <block type="controls_ifelse" x="20" y="20">
    <value name="IF0"><block type="mpu6050_foi_movimentado"><field name="SCL">3</field><field name="SDA">2</field></block></value>
    <statement name="DO0"><block type="mostrar_emoji"><field name="BRILHO">30</field><value name="EMOJI"><block type="emoji_rosto_surpreso"></block></value><value name="COR"><block type="colour_red"></block></value></block></statement>
    <statement name="ELSE"><block type="mostrar_emoji"><field name="BRILHO">20</field><value name="EMOJI"><block type="emoji_rosto_feliz"></block></value><value name="COR"><block type="colour_green"></block></value></block></statement>
    <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">300</field></block></value></block></next>
  </block>
</xml>

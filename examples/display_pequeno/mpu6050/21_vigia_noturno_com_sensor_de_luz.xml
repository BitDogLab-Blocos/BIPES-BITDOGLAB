<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- O alarme reage ao movimento somente quando o LDR na ANA-IN indica um ambiente escuro. -->
  <block type="controls_ifelse" x="20" y="20">
    <value name="IF0"><block type="logic_operation"><field name="OP">AND</field>
      <value name="A"><block type="logic_compare"><field name="OP">LT</field><value name="A"><block type="ldr_valor"><field name="CONNECTION">ANA-IN</field></block></value><value name="B"><block type="math_number"><field name="NUM">30</field></block></value></block></value>
      <value name="B"><block type="mpu6050_foi_movimentado"><field name="SCL">3</field><field name="SDA">2</field></block></value>
    </block></value>
    <statement name="DO0"><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_red"></block></value><next><block type="bipe_duplo"><field name="VOLUME">25</field><next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">700</field></block></value></block></next></block></next></block></statement>
    <statement name="ELSE"><block type="bloco_desligar_todos_leds"><next><block type="parar_som"></block></next></block></statement>
    <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">300</field></block></value></block></next>
  </block>
</xml>

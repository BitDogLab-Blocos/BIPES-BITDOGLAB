<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Vermelho na Conexao 0 indica direita e verde na Conexao 1 indica esquerda, sem ocupar as Conexoes 2 e 3 do MPU6050. -->
  <block type="controls_ifelse" x="20" y="20">
    <value name="IF0"><block type="logic_compare"><field name="OP">GT</field><value name="A"><block type="mpu6050_inclinacao"><field name="DIRECTION">RIGHT</field><field name="SCL">3</field><field name="SDA">2</field></block></value><value name="B"><block type="math_number"><field name="NUM">15</field></block></value></block></value>
    <statement name="DO0"><block type="led_externo_ligar"><field name="CHANNEL">R</field><field name="DIG">0</field><next><block type="led_externo_desligar"><field name="CHANNEL">G</field><field name="DIG">1</field></block></next></block></statement>
    <statement name="ELSE"><block type="controls_ifelse">
      <value name="IF0"><block type="logic_compare"><field name="OP">GT</field><value name="A"><block type="mpu6050_inclinacao"><field name="DIRECTION">LEFT</field><field name="SCL">3</field><field name="SDA">2</field></block></value><value name="B"><block type="math_number"><field name="NUM">15</field></block></value></block></value>
      <statement name="DO0"><block type="led_externo_desligar"><field name="CHANNEL">R</field><field name="DIG">0</field><next><block type="led_externo_ligar"><field name="CHANNEL">G</field><field name="DIG">1</field></block></next></block></statement>
      <statement name="ELSE"><block type="led_externo_desligar"><field name="CHANNEL">R</field><field name="DIG">0</field><next><block type="led_externo_desligar"><field name="CHANNEL">G</field><field name="DIG">1</field></block></next></block></statement>
    </block></statement>
    <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">300</field></block></value></block></next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Paleta de passagem: mostra vermelho, verde e azul em sequência. -->
  <block type="bloco_alternar_led" x="20" y="20">
    <mutation items="3"></mutation>
    <value name="COLOUR0">
      <block type="colour_red"></block>
    </value>
    <value name="COLOUR1">
      <block type="colour_green"></block>
    </value>
    <value name="COLOUR2">
      <block type="colour_blue"></block>
    </value>
    <next>
      <block type="esperar_segundos">
        <value name="TIME">
          <block type="math_number">
            <field name="NUM">2</field>
          </block>
        </value>
        <next>
          <block type="bloco_desligar_todos_leds">
            <next>
              <block type="esperar_segundos">
                <value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

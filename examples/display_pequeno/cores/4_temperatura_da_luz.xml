<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Simula a mudança da luz ao longo do dia, passando suavemente de uma aparência fria para neutra e depois quente. -->
  <block type="bloco_transicao_led" x="20" y="20">
    <value name="COLOUR1"><block type="colour_skyblue"></block></value>
    <value name="COLOUR2"><block type="colour_white"></block></value>
    <next>
      <block type="bloco_transicao_led">
        <value name="COLOUR1"><block type="colour_white"></block></value>
        <value name="COLOUR2"><block type="colour_yellow"></block></value>
        <next>
          <block type="bloco_transicao_led">
            <value name="COLOUR1"><block type="colour_yellow"></block></value>
            <value name="COLOUR2"><block type="colour_orange"></block></value>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

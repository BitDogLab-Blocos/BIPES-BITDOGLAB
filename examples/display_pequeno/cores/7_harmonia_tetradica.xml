<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Mostra simultaneamente uma harmonia tetrádica na matriz, formando dois pares complementares: vermelho-ciano e amarelo-azul. -->
  <block type="criar_desenho_na_matriz" x="20" y="20">
    <mutation items="4"></mutation>
    <statement name="DESENHO0">
      <block type="acender_linha">
        <field name="LINHA">0</field><field name="INTENSITY">30</field>
        <value name="COLOUR"><block type="colour_red"></block></value>
      </block>
    </statement>
    <statement name="DESENHO1">
      <block type="acender_linha">
        <field name="LINHA">1</field><field name="INTENSITY">30</field>
        <value name="COLOUR"><block type="colour_yellow"></block></value>
      </block>
    </statement>
    <statement name="DESENHO2">
      <block type="acender_linha">
        <field name="LINHA">2</field><field name="INTENSITY">30</field>
        <value name="COLOUR"><block type="colour_cyan"></block></value>
      </block>
    </statement>
    <statement name="DESENHO3">
      <block type="acender_linha">
        <field name="LINHA">3</field><field name="INTENSITY">30</field>
        <value name="COLOUR"><block type="colour_blue"></block></value>
      </block>
    </statement>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- O contato usa a Conexao 0 e o vermelho do KY-016 usa a Conexao 1. -->
  <block type="external_contact_prepare" x="20" y="20">
    <field name="COMMON">GND</field>
    <next>
      <block type="external_contact_when_closed">
        <field name="DIG">0</field>
        <statement name="DO">
          <block type="led_externo_ligar">
            <field name="CHANNEL">R</field><field name="DIG">1</field>
            <next>
              <block type="esperar_segundos">
                <value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
                <next>
                  <block type="led_externo_desligar">
                    <field name="CHANNEL">R</field><field name="DIG">1</field>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>

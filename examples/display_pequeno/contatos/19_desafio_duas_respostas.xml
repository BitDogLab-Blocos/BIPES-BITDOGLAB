<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Com GND como fio comum, toque a Conexão 0 para acertar ou a 1 para tentar de novo; OLED, LED e som mostram a resposta. -->
  <block type="external_contact_prepare" x="20" y="20">
    <field name="COMMON">GND</field>
    <next>
      <block type="external_contact_when_closed">
        <field name="DIG">0</field>
        <statement name="DO">
          <block type="display_limpar">
            <field name="DISPLAY_TYPE">SMALL</field>
            <next>
              <block type="display_texto">
                <field name="TEXTO">Acertou!</field>
                <field name="LINHA">1</field>
                <field name="ALINHAMENTO">CENTER</field>
                <field name="DISPLAY_TYPE">SMALL</field>
                <next>
                  <block type="bloco_ligar_led">
                    <value name="COLOUR">
                      <block type="colour_green" />
                    </value>
                    <next>
                      <block type="som_de_sucesso">
                        <field name="VOLUME">25</field>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="external_contact_when_closed">
            <field name="DIG">1</field>
            <statement name="DO">
              <block type="display_limpar">
                <field name="DISPLAY_TYPE">SMALL</field>
                <next>
                  <block type="display_texto">
                    <field name="TEXTO">Tente outra</field>
                    <field name="LINHA">1</field>
                    <field name="ALINHAMENTO">CENTER</field>
                    <field name="DISPLAY_TYPE">SMALL</field>
                    <next>
                      <block type="bloco_ligar_led">
                        <value name="COLOUR">
                          <block type="colour_red" />
                        </value>
                        <next>
                          <block type="som_de_falha">
                            <field name="VOLUME">25</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

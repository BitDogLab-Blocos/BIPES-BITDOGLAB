<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Painel de movimento: compare no OLED as aceleracoes dos tres eixos. -->
  <block type="robo_inicializar" x="20" y="20">
    <field name="ESPERA">5</field>
    <next><block type="display_texto">
      <field name="TEXTO">X:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
      <next><block type="display_mostrar_valor">
        <field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
        <value name="VALOR"><block type="robo_aceleracao_x"></block></value>
        <next><block type="display_texto">
          <field name="TEXTO">Y:</field><field name="LINHA">2</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
          <next><block type="display_mostrar_valor">
            <field name="LINHA">2</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
            <value name="VALOR"><block type="robo_aceleracao_y"></block></value>
            <next><block type="display_texto">
              <field name="TEXTO">Z:</field><field name="LINHA">3</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
              <next><block type="display_mostrar_valor">
                <field name="LINHA">3</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
                <value name="VALOR"><block type="robo_aceleracao_z"></block></value>
                <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">250</field></block></value></block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

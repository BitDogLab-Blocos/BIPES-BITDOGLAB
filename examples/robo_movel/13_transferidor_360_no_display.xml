<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Transferidor interativo: use A e B para girar e veja o ponteiro acompanhar no OLED. -->
  <block type="robo_inicializar" x="20" y="20">
    <field name="ESPERA">5</field>
    <next>
      <block type="botao_se_apertado">
        <field name="BOTAO">A</field>
        <statement name="DO"><block type="robo_girar"><field name="DIRECAO">L</field><value name="GRAUS"><block type="math_number"><field name="NUM">90</field></block></value></block></statement>
        <next>
          <block type="botao_se_apertado">
            <field name="BOTAO">B</field>
            <statement name="DO"><block type="robo_girar"><field name="DIRECAO">R</field><value name="GRAUS"><block type="math_number"><field name="NUM">90</field></block></value></block></statement>
            <next><block type="robo_transferidor_360"><field name="DISPLAY_TYPE">SMALL</field></block></next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

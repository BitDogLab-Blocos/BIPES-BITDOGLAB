<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Painel de energia: mova com A/B e observe no OLED como tensao e corrente respondem. -->
  <block type="robo_inicializar" x="20" y="20">
    <field name="ESPERA">5</field>
    <next>
      <block type="botao_se_apertado">
        <field name="BOTAO">A</field>
        <statement name="DO"><block type="robo_frente"><value name="TEMPO"><block type="math_number"><field name="NUM">1</field></block></value></block></statement>
        <next>
          <block type="botao_se_apertado">
            <field name="BOTAO">B</field>
            <statement name="DO"><block type="robo_tras"><value name="TEMPO"><block type="math_number"><field name="NUM">1</field></block></value></block></statement>
            <next>
              <block type="display_texto"><field name="TEXTO">Bateria:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
              <next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="robo_tensao_bateria"></block></value>
                <next><block type="display_texto"><field name="TEXTO">Corrente:</field><field name="LINHA">2</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
                  <next><block type="display_mostrar_valor"><field name="LINHA">2</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="robo_corrente_robo"></block></value>
                    <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">500</field></block></value></block></next>
                  </block></next>
                </block></next>
              </block></next>
            </block></next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

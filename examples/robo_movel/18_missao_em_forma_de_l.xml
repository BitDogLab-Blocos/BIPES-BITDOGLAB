<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Missao em L: o botao A mostra a partida, percorre duas ruas e comemora a chegada. -->
  <block type="robo_inicializar" x="20" y="20">
    <field name="ESPERA">5</field>
    <next><block type="botao_se_apertado">
      <field name="BOTAO">A</field>
      <statement name="DO"><block type="mostrar_emoji">
        <field name="BRILHO">20</field>
        <value name="EMOJI"><block type="emoji_seta_cima"></block></value>
        <value name="COR"><block type="colour_blue"></block></value>
        <next><block type="robo_frente"><value name="TEMPO"><block type="math_number"><field name="NUM">1.5</field></block></value>
          <next><block type="robo_girar"><field name="DIRECAO">L</field><value name="GRAUS"><block type="math_number"><field name="NUM">90</field></block></value>
            <next><block type="robo_frente"><value name="TEMPO"><block type="math_number"><field name="NUM">1</field></block></value>
              <next><block type="robo_parar">
                <next><block type="mostrar_emoji"><field name="BRILHO">20</field><value name="EMOJI"><block type="emoji_rosto_feliz"></block></value><value name="COR"><block type="colour_green"></block></value>
                  <next><block type="bipe_duplo"><field name="VOLUME">30</field></block></next>
                </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block></statement>
      <next><block type="display_texto">
        <field name="TEXTO">Giro:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
        <next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="robo_giro_valor"></block></value></block></next>
      </block></next>
    </block></next>
  </block>
</xml>

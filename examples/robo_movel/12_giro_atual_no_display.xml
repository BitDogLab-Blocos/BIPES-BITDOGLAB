<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Painel de direcao: A e B fazem pequenos giros e o OLED acompanha o angulo acumulado. -->
  <block type="robo_inicializar" x="20" y="20">
    <field name="ESPERA">5</field>
    <next>
      <block type="botao_se_apertado">
        <field name="BOTAO">A</field>
        <statement name="DO"><block type="robo_girar"><field name="DIRECAO">L</field><value name="GRAUS"><block type="math_number"><field name="NUM">45</field></block></value></block></statement>
        <next>
          <block type="botao_se_apertado">
            <field name="BOTAO">B</field>
            <statement name="DO"><block type="robo_girar"><field name="DIRECAO">R</field><value name="GRAUS"><block type="math_number"><field name="NUM">45</field></block></value></block></statement>
            <next>
              <block type="botao_se_apertado">
                <field name="BOTAO">C</field>
                <statement name="DO"><block type="robo_parar"></block></statement>
                <next>
                  <block type="display_texto"><field name="TEXTO">Giro:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
                  <next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="robo_giro_valor"></block></value>
                    <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">300</field></block></value></block></next>
                  </block></next></block></next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- O display anuncia uma mudança de direção no instante certo. -->
  <block type="robo_inicializar" x="30" y="30">
    <field name="ESPERA">5</field>
    <next>
      <block type="robo_frente">
        <value name="TEMPO">
          <block type="math_number">
            <field name="NUM">0.7</field>
          </block>
        </value>
        <next>
          <block type="display_texto">
            <field name="TEXTO">VIRAR</field>
            <field name="LINHA">2</field>
            <field name="ALINHAMENTO">CENTER</field>
            <field name="DISPLAY_TYPE">SMALL</field>
            <next>
              <block type="robo_girar">
                <field name="DIRECAO">R</field>
                <value name="GRAUS">
                  <block type="math_number">
                    <field name="NUM">90</field>
                  </block>
                </value>
                <next>
                  <block type="robo_frente">
                    <value name="TEMPO">
                      <block type="math_number">
                        <field name="NUM">0.7</field>
                      </block>
                    </value>
                    <next>
                      <block type="display_texto">
                        <field name="TEXTO">CHEGOU</field>
                        <field name="LINHA">2</field>
                        <field name="ALINHAMENTO">CENTER</field>
                        <field name="DISPLAY_TYPE">SMALL</field>
                        <next>
                          <block type="robo_parar" />
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Projeto final: conte missoes, use A para resgatar, B para retornar e C para a parada de emergencia. -->
  <block type="variables_guardar" x="20" y="20">
    <field name="VAR">missoes</field>
    <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next><block type="robo_inicializar">
      <field name="ESPERA">5</field>
      <next><block type="botao_se_apertado">
        <field name="BOTAO">A</field>
        <statement name="DO"><block type="variables_adicionar"><field name="VAR">missoes</field><value name="AMOUNT"><block type="math_number"><field name="NUM">1</field></block></value>
          <next><block type="mostrar_emoji"><field name="BRILHO">20</field><value name="EMOJI"><block type="emoji_seta_cima"></block></value><value name="COR"><block type="colour_blue"></block></value>
            <next><block type="robo_frente"><value name="TEMPO"><block type="math_number"><field name="NUM">1.5</field></block></value>
              <next><block type="robo_girar"><field name="DIRECAO">L</field><value name="GRAUS"><block type="math_number"><field name="NUM">90</field></block></value>
                <next><block type="robo_frente"><value name="TEMPO"><block type="math_number"><field name="NUM">1</field></block></value>
                  <next><block type="robo_parar"><next><block type="mostrar_emoji"><field name="BRILHO">20</field><value name="EMOJI"><block type="emoji_rosto_feliz"></block></value><value name="COR"><block type="colour_green"></block></value><next><block type="bipe_duplo"><field name="VOLUME">30</field></block></next></block></next></block></next>
                </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></statement>
        <next><block type="botao_se_apertado">
          <field name="BOTAO">B</field>
          <statement name="DO"><block type="robo_tras"><value name="TEMPO"><block type="math_number"><field name="NUM">1</field></block></value><next><block type="robo_girar"><field name="DIRECAO">R</field><value name="GRAUS"><block type="math_number"><field name="NUM">180</field></block></value><next><block type="robo_parar"></block></next></block></next></block></statement>
          <next><block type="botao_se_apertado">
            <field name="BOTAO">C</field>
            <statement name="DO"><block type="robo_parar"><next><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_red"></block></value><next><block type="bipe_curto"><field name="VOLUME">35</field></block></next></block></next></block></statement>
            <next><block type="display_texto"><field name="TEXTO">Missoes:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
              <next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">missoes</field></block></value>
                <next><block type="display_texto"><field name="TEXTO">Bateria:</field><field name="LINHA">2</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
                  <next><block type="display_mostrar_valor"><field name="LINHA">2</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="robo_tensao_bateria"></block></value>
                    <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">250</field></block></value></block></next>
                  </block></next>
                </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

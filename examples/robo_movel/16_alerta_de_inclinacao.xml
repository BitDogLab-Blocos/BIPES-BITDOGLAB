<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Alerta de inclinacao: uma aceleracao X maior que 3 acende vermelho e toca um bipe. -->
  <block type="robo_inicializar" x="20" y="20">
    <field name="ESPERA">5</field>
    <next><block type="controls_ifelse">
      <value name="IF0"><block type="logic_compare">
        <field name="OP">GT</field>
        <value name="A"><block type="robo_aceleracao_x"></block></value>
        <value name="B"><block type="math_number"><field name="NUM">3</field></block></value>
      </block></value>
      <statement name="DO0"><block type="bloco_ligar_led">
        <value name="COLOUR"><block type="colour_red"></block></value>
        <next><block type="bipe_curto"><field name="VOLUME">25</field></block></next>
      </block></statement>
      <statement name="ELSE"><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_green"></block></value></block></statement>
      <next><block type="display_texto">
        <field name="TEXTO">Acel X:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
        <next><block type="display_mostrar_valor">
          <field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
          <value name="VALOR"><block type="robo_aceleracao_x"></block></value>
          <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">300</field></block></value></block></next>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

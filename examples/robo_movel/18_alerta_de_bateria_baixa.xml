<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Alerta de bateria: abaixo de 6 V use luz vermelha e bipe; caso contrario use verde. -->
  <block type="robo_inicializar" x="20" y="20">
    <field name="ESPERA">5</field>
    <next><block type="controls_ifelse">
      <value name="IF0"><block type="logic_compare"><field name="OP">LT</field><value name="A"><block type="robo_tensao_bateria"></block></value><value name="B"><block type="math_number"><field name="NUM">6</field></block></value></block></value>
      <statement name="DO0"><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_red"></block></value><next><block type="bipe_duplo"><field name="VOLUME">30</field></block></next></block></statement>
      <statement name="ELSE"><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_green"></block></value></block></statement>
      <next><block type="display_texto"><field name="TEXTO">Bateria:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
        <next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="robo_tensao_bateria"></block></value>
          <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">500</field></block></value></block></next>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

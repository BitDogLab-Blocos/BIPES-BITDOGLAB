<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Ida e volta: avance ate o alvo, pare, retorne e pare novamente. -->
  <block type="robo_inicializar" x="20" y="20">
    <field name="ESPERA">5</field>
    <next>
      <block type="robo_frente">
        <value name="TEMPO"><block type="math_number"><field name="NUM">1.5</field></block></value>
        <next>
          <block type="robo_parar">
            <next>
              <block type="robo_tras">
                <value name="TEMPO"><block type="math_number"><field name="NUM">1.5</field></block></value>
                <next><block type="robo_parar"></block></next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Guarda 1 quando o MPU6050 detecta movimento e mostra o estado junto da distancia. -->
  <block type="variables_guardar" x="20" y="20"><field name="VAR">movido</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next><block type="controls_ifelse">
      <value name="IF0"><block type="mpu6050_foi_movimentado"><field name="SCL">3</field><field name="SDA">2</field></block></value>
      <statement name="DO0"><block type="variables_alterar"><field name="VAR">movido</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">movido</field></block></value><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value></block></statement>
      <statement name="ELSE"><block type="variables_alterar"><field name="VAR">movido</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">movido</field></block></value><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value></block></statement>
      <next><block type="display_texto"><field name="TEXTO">Movido (0/1):</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
        <next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">movido</field></block></value>
          <next><block type="display_texto"><field name="TEXTO">Dist cm:</field><field name="LINHA">2</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
            <next><block type="display_mostrar_valor"><field name="LINHA">2</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="ultrassonico_distancia"><field name="TRIG">3</field><field name="ECHO">2</field></block></value>
              <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">300</field></block></value></block></next>
            </block></next>
          </block></next>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

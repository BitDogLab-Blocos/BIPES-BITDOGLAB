<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Mostra no OLED a aceleracao para frente e para tras medida no eixo Y. -->
  <block type="display_texto" x="20" y="20"><field name="TEXTO">Eixo Y:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
    <next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
      <value name="VALOR"><block type="mpu6050_aceleracao"><field name="AXIS">Y</field><field name="SCL">3</field><field name="SDA">2</field></block></value>
    </block></next>
  </block>
</xml>

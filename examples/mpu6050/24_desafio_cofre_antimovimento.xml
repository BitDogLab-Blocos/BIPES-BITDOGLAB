<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Projeto final: o contato na Conexao 1 arma o cofre; movimento fecha o servo da Conexao 0, toca o alarme e conta ocorrencias no OLED. -->
  <block type="variables_guardar" x="20" y="20"><field name="VAR">alertas</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next><block type="external_contact_prepare"><field name="COMMON">GND</field>
      <next><block type="controls_ifelse">
        <value name="IF0"><block type="logic_operation"><field name="OP">AND</field>
          <value name="A"><block type="external_contact_is_closed"><field name="DIG">1</field></block></value>
          <value name="B"><block type="mpu6050_foi_movimentado"><field name="SCL">3</field><field name="SDA">2</field></block></value>
        </block></value>
        <statement name="DO0"><block type="variables_adicionar"><field name="VAR">alertas</field><value name="AMOUNT"><block type="math_number"><field name="NUM">1</field></block></value>
          <next><block type="servo_mover"><field name="DIG">0</field><field name="ANGLE">0</field>
            <next><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_red"></block></value>
              <next><block type="alerta_intermitente"><field name="VOLUME">25</field><next><block type="esperar_segundos"><value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value></block></next></block></next>
            </block></next>
          </block></next>
        </block></statement>
        <statement name="ELSE"><block type="servo_mover"><field name="DIG">0</field><field name="ANGLE">90</field><next><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_green"></block></value><next><block type="parar_som"></block></next></block></next></block></statement>
        <next><block type="display_texto"><field name="TEXTO">Alertas:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
          <next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">alertas</field></block></value>
            <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">300</field></block></value></block></next>
          </block></next>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Os botoes A, B e C escolhem se o OLED mostra a aceleracao X, Y ou Z. -->
  <block type="botao_se_apertado" x="20" y="20"><field name="BOTAO">A</field>
    <statement name="DO"><block type="display_limpar"><field name="DISPLAY_TYPE">SMALL</field><next><block type="display_texto"><field name="TEXTO">Eixo X:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field><next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="mpu6050_aceleracao"><field name="AXIS">X</field><field name="SCL">3</field><field name="SDA">2</field></block></value></block></next></block></next></block></statement>
    <next><block type="botao_se_apertado"><field name="BOTAO">B</field>
      <statement name="DO"><block type="display_limpar"><field name="DISPLAY_TYPE">SMALL</field><next><block type="display_texto"><field name="TEXTO">Eixo Y:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field><next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="mpu6050_aceleracao"><field name="AXIS">Y</field><field name="SCL">3</field><field name="SDA">2</field></block></value></block></next></block></next></block></statement>
      <next><block type="botao_se_apertado"><field name="BOTAO">C</field>
        <statement name="DO"><block type="display_limpar"><field name="DISPLAY_TYPE">SMALL</field><next><block type="display_texto"><field name="TEXTO">Eixo Z:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field><next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="mpu6050_aceleracao"><field name="AXIS">Z</field><field name="SCL">3</field><field name="SDA">2</field></block></value></block></next></block></next></block></statement>
        <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">300</field></block></value></block></next>
      </block></next>
    </block></next>
  </block>
</xml>

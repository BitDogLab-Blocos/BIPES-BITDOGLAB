<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Conta movimentos separados e mostra no OLED quantos foram reconhecidos. -->
  <block type="variables_guardar" x="20" y="20"><field name="VAR">movimentos</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next><block type="controls_if">
      <value name="IF0"><block type="mpu6050_foi_movimentado"><field name="SCL">3</field><field name="SDA">2</field></block></value>
      <statement name="DO0"><block type="variables_adicionar"><field name="VAR">movimentos</field><value name="AMOUNT"><block type="math_number"><field name="NUM">1</field></block></value><next><block type="bipe_curto"><field name="VOLUME">20</field><next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">600</field></block></value></block></next></block></next></block></statement>
      <next><block type="display_texto"><field name="TEXTO">Movimentos:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
        <next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">movimentos</field></block></value>
          <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">300</field></block></value></block></next>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

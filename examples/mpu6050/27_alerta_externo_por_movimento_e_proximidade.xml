<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- O LED vermelho externo acende se houver movimento com um objeto a menos de 20 cm. -->
  <block type="controls_ifelse" x="20" y="20">
    <value name="IF0"><block type="logic_operation"><field name="OP">AND</field><value name="A"><block type="mpu6050_foi_movimentado"><field name="SCL">3</field><field name="SDA">2</field></block></value><value name="B"><block type="logic_compare"><field name="OP">LT</field><value name="A"><block type="ultrassonico_distancia"><field name="TRIG">3</field><field name="ECHO">2</field></block></value><value name="B"><block type="math_number"><field name="NUM">20</field></block></value></block></value></block></value>
    <statement name="DO0"><block type="led_externo_ligar"><field name="CHANNEL">R</field><field name="DIG">0</field></block></statement>
    <statement name="ELSE"><block type="led_externo_desligar"><field name="CHANNEL">R</field><field name="DIG">0</field></block></statement>
    <next><block type="display_texto"><field name="TEXTO">Dist cm:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
      <next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="ultrassonico_distancia"><field name="TRIG">3</field><field name="ECHO">2</field></block></value>
        <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">300</field></block></value></block></next>
      </block></next>
    </block></next>
  </block>
</xml>

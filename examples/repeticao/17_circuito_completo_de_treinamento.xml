<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Projeto final: variável, matemática, LED, matriz, OLED e som formam seis rodadas didáticas. -->
  <block type="variables_guardar" x="30" y="30">
    <field name="VAR">etapa</field>
    <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next>
      <block type="controls_repeat_simple">
        <field name="TIMES">6</field>
        <statement name="DO">
          <block type="variables_adicionar">
            <field name="VAR">etapa</field>
            <value name="AMOUNT"><block type="math_number"><field name="NUM">1</field></block></value>
            <next>
              <block type="controls_ifelse">
                <value name="IF0">
                  <block type="math_is_divisible_by">
                    <value name="DIVIDEND"><block type="variables_valor_guardado"><field name="VAR">etapa</field></block></value>
                    <value name="DIVISOR"><block type="math_number"><field name="NUM">2</field></block></value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="bloco_ligar_led">
                    <value name="COLOUR"><block type="colour_red"></block></value>
                    <next>
                      <block type="mostrar_emoji">
                        <value name="EMOJI"><block type="emoji_coracao"></block></value>
                        <value name="COR"><block type="colour_red"></block></value>
                        <field name="BRILHO">30</field>
                      </block>
                    </next>
                  </block>
                </statement>
                <statement name="ELSE">
                  <block type="bloco_ligar_led">
                    <value name="COLOUR"><block type="colour_green"></block></value>
                    <next>
                      <block type="mostrar_emoji">
                        <value name="EMOJI"><block type="emoji_rosto_feliz"></block></value>
                        <value name="COR"><block type="colour_green"></block></value>
                        <field name="BRILHO">30</field>
                      </block>
                    </next>
                  </block>
                </statement>
                <next>
                  <block type="display_mostrar_valor">
                    <field name="LINHA">1</field>
                    <field name="ALINHAMENTO">CENTER</field>
                    <field name="DISPLAY_TYPE">SMALL</field>
                    <value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">etapa</field></block></value>
                    <next>
                      <block type="tocar_som_agudo">
                        <field name="VOLUME">25</field>
                        <field name="DURATION">120</field>
                        <next>
                          <block type="esperar_segundos">
                            <value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>

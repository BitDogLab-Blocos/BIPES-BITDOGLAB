<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Estação de alerta: ruído preenche a matriz, gera alerta sonoro e soma ocorrências acima do limiar. -->
  <block type="variables_guardar" x="30" y="30">
    <field name="VAR">alertas</field>
    <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next>
      <block type="controls_repeat_simple">
        <field name="TIMES">8</field>
        <statement name="DO">
          <block type="microfone_vu_meter">
            <field name="BRILHO">30</field>
            <value name="COR"><block type="colour_orange"></block></value>
            <next>
              <block type="display_texto">
                <field name="TEXTO">Som:</field>
                <field name="LINHA">1</field>
                <field name="ALINHAMENTO">LEFT</field>
                <field name="DISPLAY_TYPE">SMALL</field>
                <next>
                  <block type="display_mostrar_valor">
                    <field name="LINHA">1</field>
                    <field name="ALINHAMENTO">RIGHT</field>
                    <field name="DISPLAY_TYPE">SMALL</field>
                    <value name="VALOR"><block type="microfone_nivel_atual"></block></value>
                    <next>
                      <block type="controls_ifelse">
                        <value name="IF0">
                          <block type="logic_compare">
                            <field name="OP">GT</field>
                            <value name="A"><block type="microfone_nivel_atual"></block></value>
                            <value name="B"><block type="math_number"><field name="NUM">2</field></block></value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="variables_adicionar">
                            <field name="VAR">alertas</field>
                            <value name="AMOUNT"><block type="math_number"><field name="NUM">1</field></block></value>
                            <next>
                              <block type="bloco_ligar_led">
                                <value name="COLOUR"><block type="colour_red"></block></value>
                                <next>
                                  <block type="bipe_duplo"><field name="VOLUME">35</field></block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </statement>
                        <statement name="ELSE">
                          <block type="bloco_ligar_led">
                            <value name="COLOUR"><block type="colour_green"></block></value>
                          </block>
                        </statement>
                        <next>
                          <block type="display_texto">
                            <field name="TEXTO">Alerta:</field>
                            <field name="LINHA">2</field>
                            <field name="ALINHAMENTO">LEFT</field>
                            <field name="DISPLAY_TYPE">SMALL</field>
                            <next>
                              <block type="display_mostrar_valor">
                                <field name="LINHA">2</field>
                                <field name="ALINHAMENTO">RIGHT</field>
                                <field name="DISPLAY_TYPE">SMALL</field>
                                <value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">alertas</field></block></value>
                                <next>
                                  <block type="esperar_milisegundos">
                                    <value name="TIME"><block type="math_number"><field name="NUM">1000</field></block></value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>

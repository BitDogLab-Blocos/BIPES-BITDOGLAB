<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Primeiro contato com a repetição: o LED vermelho pisca cinco vezes. -->
  <block type="controls_repeat_simple" x="30" y="30">
    <field name="TIMES">5</field>
    <statement name="DO">
      <block type="bloco_ligar_led">
        <value name="COLOUR"><block type="colour_red"></block></value>
        <next>
          <block type="esperar_segundos">
            <value name="TIME"><block type="math_number"><field name="NUM">0.4</field></block></value>
            <next>
              <block type="bloco_desligar_led">
                <value name="COLOUR"><block type="colour_red"></block></value>
                <next>
                  <block type="esperar_segundos">
                    <value name="TIME"><block type="math_number"><field name="NUM">0.4</field></block></value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>

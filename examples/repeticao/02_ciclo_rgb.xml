<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Uma repetição pode conter uma sequência inteira: vermelho, verde e azul. -->
  <block type="controls_repeat_simple" x="30" y="30">
    <field name="TIMES">3</field>
    <statement name="DO">
      <block type="bloco_ligar_led">
        <value name="COLOUR"><block type="colour_red"></block></value>
        <next>
          <block type="esperar_milisegundos">
            <value name="TIME"><block type="math_number"><field name="NUM">200</field></block></value>
            <next>
              <block type="bloco_ligar_led">
                <value name="COLOUR"><block type="colour_green"></block></value>
                <next>
                  <block type="esperar_milisegundos">
                    <value name="TIME"><block type="math_number"><field name="NUM">200</field></block></value>
                    <next>
                      <block type="bloco_ligar_led">
                        <value name="COLOUR"><block type="colour_blue"></block></value>
                        <next>
                          <block type="esperar_milisegundos">
                            <value name="TIME"><block type="math_number"><field name="NUM">200</field></block></value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>

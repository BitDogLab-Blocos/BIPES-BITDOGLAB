<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Projeto 1: botões alteram uma pontuação; matemática e OLED tornam o estado visível. -->
  <block type="variables_guardar" x="20" y="20">
    <field name="VAR">pontos</field>
    <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next>
      <block type="botao_se_apertado">
        <field name="BOTAO">A</field>
        <statement name="DO"><block type="variables_adicionar"><field name="VAR">pontos</field><value name="AMOUNT"><block type="math_number"><field name="NUM">5</field></block></value></block></statement>
        <next>
          <block type="botao_se_apertado">
            <field name="BOTAO">B</field>
            <statement name="DO"><block type="variables_tirar"><field name="VAR">pontos</field><value name="AMOUNT"><block type="math_number"><field name="NUM">2</field></block></value></block></statement>
            <next>
              <block type="display_mostrar_calculo">
                <field name="LINHA">1</field><field name="ALINHAMENTO">CENTER</field>
                <value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">pontos</field></block></value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

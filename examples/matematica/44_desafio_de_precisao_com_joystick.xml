<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Projeto grande 2: distância ao centro do joystick vira pontuação, alvo na matriz e feedback sonoro. -->
  <block type="variables_guardar" x="20" y="20">
    <field name="VAR">distancia</field>
    <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next>
      <block type="variables_alterar">
        <field name="VAR">distancia</field>
        <value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">distancia</field></block></value>
        <value name="VALUE"><block type="math_single"><field name="OP">ABS</field><value name="NUM"><block type="math_arithmetic"><field name="OP">MINUS</field><value name="A"><block type="joystick_posicao_x"></block></value><value name="B"><block type="math_number"><field name="NUM">64</field></block></value></block></value></block></value>
        <next>
          <block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">CENTER</field><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">distancia</field></block></value>
            <next>
              <block type="display_mostrar_calculo"><field name="LINHA">2</field><field name="ALINHAMENTO">CENTER</field><value name="VALOR"><block type="math_round_to_decimal"><field name="DECIMAL_PLACES">0</field><value name="NUMBER_TO_ROUND"><block type="joystick_posicao_y"></block></value></block></value>
                <next>
                  <block type="controls_ifelse">
                    <value name="IF0"><block type="logic_compare"><field name="OP">LTE</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">distancia</field></block></value><value name="B"><block type="math_number"><field name="NUM">8</field></block></value></block></value>
                    <statement name="DO0">
                      <block type="bloco_acender_led_brilho"><field name="INTENSITY">100</field><value name="COLOUR"><block type="colour_green"></block></value>
                        <next><block type="preencher_matriz"><field name="INTENSITY">30</field><value name="COLOUR"><block type="colour_green"></block></value><next><block type="tocar_som_agudo"><field name="VOLUME">50</field><field name="DURATION">250</field></block></next></block>
                        </next>
                      </block>
                    </statement>
                    <statement name="ELSE">
                      <block type="bloco_acender_led_brilho"><field name="INTENSITY">35</field><value name="COLOUR"><block type="colour_red"></block></value>
                        <next><block type="preencher_matriz"><field name="INTENSITY">30</field><value name="COLOUR"><block type="colour_red"></block></value><next><block type="bipe_curto"></block></next></block>
                        </next>
                      </block>
                    </statement>
                    <next><block type="display_texto"><field name="TEXTO">Centro = acerto</field><field name="LINHA">3</field><field name="ALINHAMENTO">CENTER</field></block></next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

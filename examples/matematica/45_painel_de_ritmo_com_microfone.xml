<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Projeto grande 3: o microfone mede intensidade, a matemática cria escala e os periféricos respondem. -->
  <block type="variables_guardar" x="20" y="20">
    <field name="VAR">intensidade</field>
    <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next>
      <block type="microfone_vu_meter"><field name="BRILHO">30</field><value name="COR"><block type="colour_cyan"></block></value>
        <next>
          <block type="variables_alterar">
            <field name="VAR">intensidade</field>
            <value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">intensidade</field></block></value>
            <value name="VALUE"><block type="microfone_barra_pct"></block></value>
            <next>
              <block type="microfone_barra_display"><field name="LINHA">5</field>
                <next>
                  <block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">CENTER</field><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">intensidade</field></block></value>
                    <next>
                      <block type="display_mostrar_calculo"><field name="LINHA">2</field><field name="ALINHAMENTO">CENTER</field><value name="VALOR"><block type="math_round_to_decimal"><field name="DECIMAL_PLACES">0</field><value name="NUMBER_TO_ROUND"><block type="math_arithmetic"><field name="OP">DIVIDE</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">intensidade</field></block></value><value name="B"><block type="math_number"><field name="NUM">2</field></block></value></block></value></block></value>
                        <next>
                          <block type="controls_ifelse">
                            <value name="IF0"><block type="logic_compare"><field name="OP">GTE</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">intensidade</field></block></value><value name="B"><block type="math_number"><field name="NUM">70</field></block></value></block></value>
                            <statement name="DO0">
                              <block type="bloco_acender_led_brilho"><field name="INTENSITY">100</field><value name="COLOUR"><block type="colour_red"></block></value>
                                <next><block type="preencher_matriz"><field name="INTENSITY">30</field><value name="COLOUR"><block type="colour_red"></block></value><next><block type="tocar_som_agudo"><field name="VOLUME">50</field><field name="DURATION">300</field></block></next></block>
                                </next>
                              </block>
                            </statement>
                            <statement name="ELSE">
                              <block type="bloco_acender_led_brilho"><field name="INTENSITY">20</field><value name="COLOUR"><block type="colour_blue"></block></value>
                                <next><block type="preencher_matriz"><field name="INTENSITY">30</field><value name="COLOUR"><block type="colour_cyan"></block></value><next><block type="bipe_curto"></block></next></block>
                                </next>
                              </block>
                            </statement>
                            <next>
                              <block type="display_mostrar_valor"><field name="LINHA">3</field><field name="ALINHAMENTO">CENTER</field><value name="VALOR"><block type="math_modulo"><value name="DIVIDEND"><block type="variables_valor_guardado"><field name="VAR">intensidade</field></block></value><value name="DIVISOR"><block type="math_number"><field name="NUM">2</field></block></value></block></value>
                                <next><block type="display_texto"><field name="TEXTO">Fale ou bata palmas</field><field name="LINHA">4</field><field name="ALINHAMENTO">CENTER</field></block></next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

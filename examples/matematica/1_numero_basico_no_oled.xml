<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Primeiro contato: o botão A imprime um número literal e o OLED o apresenta sempre. -->
  <block type="botao_se_apertado" x="20" y="20">
    <field name="BOTAO">A</field>
    <statement name="DO">
      <block type="math_print_value">
        <value name="VALUE"><block type="math_number"><field name="NUM">42</field></block></value>
      </block>
    </statement>
    <next>
      <block type="display_mostrar_calculo">
        <field name="LINHA">1</field>
        <field name="ALINHAMENTO">CENTER</field>
        <value name="VALOR"><block type="math_number"><field name="NUM">42</field></block></value>
      </block>
    </next>
  </block>
</xml>

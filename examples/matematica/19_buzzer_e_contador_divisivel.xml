<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Projeto 5: cada aperto soma um; múltiplos de três têm som agudo, os demais um bipe curto. -->
  <block type="variables_guardar" x="20" y="20">
    <field name="VAR">contagem</field>
    <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next>
      <block type="botao_se_apertado"><field name="BOTAO">A</field>
        <statement name="DO"><block type="variables_adicionar"><field name="VAR">contagem</field><value name="AMOUNT"><block type="math_number"><field name="NUM">1</field></block></value></block></statement>
        <next>
          <block type="controls_ifelse">
            <value name="IF0"><block type="math_is_divisible_by"><value name="DIVIDEND"><block type="variables_valor_guardado"><field name="VAR">contagem</field></block></value><value name="DIVISOR"><block type="math_number"><field name="NUM">3</field></block></value></block></value>
            <statement name="DO0"><block type="tocar_som_agudo"><field name="VOLUME">50</field><field name="DURATION">300</field></block></statement>
            <statement name="ELSE"><block type="bipe_curto"></block></statement>
            <next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">CENTER</field><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">contagem</field></block></value></block></next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

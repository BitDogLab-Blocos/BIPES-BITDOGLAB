<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Projeto grande 1: botões alteram pontos, faixas controlam LED, conta e som; o OLED explica o placar. -->
  <block type="variables_guardar" x="20" y="20">
    <field name="VAR">pontos</field>
    <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next>
      <block type="botao_se_apertado">
        <field name="BOTAO">A</field>
        <statement name="DO"><block type="variables_adicionar"><field name="VAR">pontos</field><value name="AMOUNT"><block type="math_number"><field name="NUM">5</field></block></value></block></statement>
        <next>
          <block type="botao_se_apertado">
            <field name="BOTAO">B</field>
            <statement name="DO"><block type="variables_tirar"><field name="VAR">pontos</field><value name="AMOUNT"><block type="math_number"><field name="NUM">2</field></block></value></block></statement>
            <next>
              <block type="controls_ifelse">
                <value name="IF0"><block type="logic_compare"><field name="OP">GTE</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">pontos</field></block></value><value name="B"><block type="math_number"><field name="NUM">10</field></block></value></block></value>
                <statement name="DO0"><block type="bloco_acender_led_brilho"><field name="INTENSITY">80</field><value name="COLOUR"><block type="colour_green"></block></value></block></statement>
                <statement name="ELSE"><block type="bloco_acender_led_brilho"><field name="INTENSITY">20</field><value name="COLOUR"><block type="colour_blue"></block></value></block></statement>
                <next>
                  <block type="display_mostrar_calculo">
                    <field name="LINHA">1</field><field name="ALINHAMENTO">CENTER</field>
                    <value name="VALOR"><block type="math_arithmetic"><field name="OP">DIVIDE</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">pontos</field></block></value><value name="B"><block type="math_number"><field name="NUM">5</field></block></value></block></value>
                    <next>
                      <block type="display_mostrar_valor"><field name="LINHA">2</field><field name="ALINHAMENTO">CENTER</field><value name="VALOR"><block type="math_modulo"><value name="DIVIDEND"><block type="variables_valor_guardado"><field name="VAR">pontos</field></block></value><value name="DIVISOR"><block type="math_number"><field name="NUM">5</field></block></value></block></value>
                        <next>
                          <block type="controls_ifelse">
                            <value name="IF0"><block type="math_is_divisible_by"><value name="DIVIDEND"><block type="variables_valor_guardado"><field name="VAR">pontos</field></block></value><value name="DIVISOR"><block type="math_number"><field name="NUM">10</field></block></value></block></value>
                            <statement name="DO0"><block type="tocar_som_agudo"><field name="VOLUME">50</field><field name="DURATION">250</field></block></statement>
                            <statement name="ELSE"><block type="bipe_curto"></block></statement>
                            <next><block type="display_texto"><field name="TEXTO">A +5   B -2</field><field name="LINHA">3</field><field name="ALINHAMENTO">CENTER</field></block></next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

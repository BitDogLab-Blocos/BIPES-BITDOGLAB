<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Soma e subtração: combine blocos para construir uma expressão passo a passo. -->
  <block type="display_mostrar_calculo" x="20" y="20">
    <field name="LINHA">1</field>
    <field name="ALINHAMENTO">CENTER</field>
    <value name="VALOR">
      <block type="math_arithmetic">
        <field name="OP">ADD</field>
        <value name="A"><block type="math_number"><field name="NUM">18</field></block></value>
        <value name="B">
          <block type="math_arithmetic">
            <field name="OP">MINUS</field>
            <value name="A"><block type="math_number"><field name="NUM">10</field></block></value>
            <value name="B"><block type="math_number"><field name="NUM">3</field></block></value>
          </block>
        </value>
      </block>
    </value>
  </block>
</xml>

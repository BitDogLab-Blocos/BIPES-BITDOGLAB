<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="mostrar_emoji" x="30" y="30">
    <!-- Apresenta símbolos de sol, chuva e flor como uma previsão visual simples. -->
    <value name="EMOJI"><block type="emoji_sol"></block></value>
    <value name="COR"><block type="colour_yellow"></block></value>
    <field name="BRILHO">30</field>
    <next>
      <block type="esperar_segundos">
        <value name="TIME"><block type="math_number"><field name="NUM">2</field></block></value>
        <next>
          <block type="mostrar_emoji">
            <value name="EMOJI"><block type="emoji_chuva"></block></value>
            <value name="COR"><block type="colour_skyblue"></block></value>
            <field name="BRILHO">30</field>
            <next>
              <block type="esperar_segundos">
                <value name="TIME"><block type="math_number"><field name="NUM">2</field></block></value>
                <next>
                  <block type="mostrar_emoji">
                    <value name="EMOJI"><block type="emoji_flor"></block></value>
                    <value name="COR"><block type="colour_magenta"></block></value>
                    <field name="BRILHO">30</field>
                    <next>
                      <block type="esperar_segundos">
                        <value name="TIME"><block type="math_number"><field name="NUM">2</field></block></value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>


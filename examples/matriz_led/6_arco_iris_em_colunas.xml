<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Faixas de cor: usa as cinco colunas para formar um pequeno arco-íris. -->
  <block type="criar_desenho_na_matriz" x="20" y="20">
    <mutation items="5"></mutation>
    <statement name="DESENHO0">
      <block type="acender_coluna">
        <field name="COLUNA">0</field>
        <field name="INTENSITY">30</field>
        <value name="COLOUR"><block type="colour_red"></block></value>
      </block>
    </statement>
    <statement name="DESENHO1">
      <block type="acender_coluna">
        <field name="COLUNA">1</field>
        <field name="INTENSITY">30</field>
        <value name="COLOUR"><block type="colour_orange"></block></value>
      </block>
    </statement>
    <statement name="DESENHO2">
      <block type="acender_coluna">
        <field name="COLUNA">2</field>
        <field name="INTENSITY">30</field>
        <value name="COLOUR"><block type="colour_yellow"></block></value>
      </block>
    </statement>
    <statement name="DESENHO3">
      <block type="acender_coluna">
        <field name="COLUNA">3</field>
        <field name="INTENSITY">30</field>
        <value name="COLOUR"><block type="colour_green"></block></value>
      </block>
    </statement>
    <statement name="DESENHO4">
      <block type="acender_coluna">
        <field name="COLUNA">4</field>
        <field name="INTENSITY">30</field>
        <value name="COLOUR"><block type="colour_blue"></block></value>
      </block>
    </statement>
  </block>
</xml>

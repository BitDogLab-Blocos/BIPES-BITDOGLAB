<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="mostrar_emoji" x="30" y="30">
    <!-- Cria uma sequência natalina com árvore, floco de neve, presente e sino. -->
    <value name="EMOJI"><block type="emoji_arvore_natal"></block></value>
    <value name="COR"><block type="colour_green"></block></value>
    <field name="BRILHO">65</field>
    <next>
      <block type="esperar_segundos">
        <value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
        <next>
          <block type="mostrar_emoji">
            <value name="EMOJI"><block type="emoji_floco_neve"></block></value>
            <value name="COR"><block type="colour_cyan"></block></value>
            <field name="BRILHO">65</field>
            <next>
              <block type="esperar_segundos">
                <value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
                <next>
                  <block type="mostrar_emoji">
                    <value name="EMOJI"><block type="emoji_presente"></block></value>
                    <value name="COR"><block type="colour_red"></block></value>
                    <field name="BRILHO">65</field>
                    <next>
                      <block type="esperar_segundos">
                        <value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
                        <next>
                          <block type="mostrar_emoji">
                            <value name="EMOJI"><block type="emoji_sino_natal"></block></value>
                            <value name="COR"><block type="colour_yellow"></block></value>
                            <field name="BRILHO">65</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>


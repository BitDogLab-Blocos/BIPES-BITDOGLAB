<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="matriz_piscar_lento" x="30" y="30">
    <!-- Faz um coração piscar lentamente, como uma sinalização suave. -->
    <statement name="DO">
      <block type="mostrar_emoji">
        <value name="EMOJI"><block type="emoji_coracao"></block></value>
        <value name="COR"><block type="colour_pink"></block></value>
        <field name="BRILHO">30</field>
      </block>
    </statement>
  </block>
</xml>


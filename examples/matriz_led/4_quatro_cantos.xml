<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Marcador de área: cria um desenho com LEDs coloridos nos quatro cantos da matriz. -->
  <block type="criar_desenho_na_matriz" x="20" y="20">
    <mutation items="4"></mutation>
    <statement name="DESENHO0">
      <block type="acender_led_posicao">
        <field name="LINHA">0</field>
        <field name="COLUNA">0</field>
        <field name="INTENSITY">35</field>
        <value name="COLOUR">
          <block type="colour_red"></block>
        </value>
      </block>
    </statement>
    <statement name="DESENHO1">
      <block type="acender_led_posicao">
        <field name="LINHA">0</field>
        <field name="COLUNA">4</field>
        <field name="INTENSITY">35</field>
        <value name="COLOUR">
          <block type="colour_green"></block>
        </value>
      </block>
    </statement>
    <statement name="DESENHO2">
      <block type="acender_led_posicao">
        <field name="LINHA">4</field>
        <field name="COLUNA">0</field>
        <field name="INTENSITY">35</field>
        <value name="COLOUR">
          <block type="colour_blue"></block>
        </value>
      </block>
    </statement>
    <statement name="DESENHO3">
      <block type="acender_led_posicao">
        <field name="LINHA">4</field>
        <field name="COLUNA">4</field>
        <field name="INTENSITY">35</field>
        <value name="COLOUR">
          <block type="colour_yellow"></block>
        </value>
      </block>
    </statement>
  </block>
</xml>

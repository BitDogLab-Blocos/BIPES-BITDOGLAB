<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="matriz_deslizar_baixo" x="30" y="30">
    <!-- Desliza uma seta para baixo para indicar retorno ou descida. -->
    <statement name="DO">
      <block type="mostrar_emoji">
        <value name="EMOJI"><block type="emoji_seta_baixo"></block></value>
        <value name="COR"><block type="colour_skyblue"></block></value>
        <field name="BRILHO">75</field>
      </block>
    </statement>
  </block>
</xml>


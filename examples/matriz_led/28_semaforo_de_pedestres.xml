<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="preencher_matriz" x="30" y="30">
    <!-- Semáforo de pedestres: começa fechado. Ao pressionar A, libera a travessia, avisa que o tempo está terminando e volta a fechar. -->
    <field name="INTENSITY">30</field>
    <value name="COLOUR"><block type="colour_red"></block></value>
    <next>
      <block type="botao_se_apertado">
        <field name="BOTAO">A</field>
        <statement name="DO">
          <block type="mostrar_emoji">
            <value name="EMOJI"><block type="emoji_seta_cima"></block></value>
            <value name="COR"><block type="colour_green"></block></value>
            <field name="BRILHO">30</field>
            <next>
              <block type="esperar_segundos">
                <value name="TIME"><block type="math_number"><field name="NUM">5</field></block></value>
                <next>
                  <block type="matriz_piscar_rapido">
                    <statement name="DO">
                      <block type="mostrar_emoji">
                        <value name="EMOJI"><block type="emoji_seta_cima"></block></value>
                        <value name="COR"><block type="colour_yellow"></block></value>
                        <field name="BRILHO">30</field>
                      </block>
                    </statement>
                    <next>
                      <block type="preencher_matriz">
                        <field name="INTENSITY">30</field>
                        <value name="COLOUR"><block type="colour_red"></block></value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>


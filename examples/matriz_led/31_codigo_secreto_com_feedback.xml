<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="variables_guardar" x="30" y="30">
    <!-- Código secreto: A digita 1, B digita 2 e C confirma. A sequência 1212 mostra sucesso; qualquer outra mostra erro e reinicia. -->
    <field name="VAR">codigo</field>
    <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next>
      <block type="botao_se_apertado">
        <field name="BOTAO">A</field>
        <statement name="DO">
          <block type="variables_alterar">
            <field name="VAR">codigo</field>
            <value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">codigo</field></block></value>
            <value name="VALUE">
              <block type="math_arithmetic">
                <field name="OP">ADD</field>
                <value name="A">
                  <block type="math_arithmetic">
                    <field name="OP">MULTIPLY</field>
                    <value name="A"><block type="variables_valor_guardado"><field name="VAR">codigo</field></block></value>
                    <value name="B"><block type="math_number"><field name="NUM">10</field></block></value>
                  </block>
                </value>
                <value name="B"><block type="math_number"><field name="NUM">1</field></block></value>
              </block>
            </value>
            <next>
              <block type="mostrar_numero_matriz">
                <value name="NUMERO"><block type="numero_matriz_1"></block></value>
                <value name="COR"><block type="colour_skyblue"></block></value>
                <field name="BRILHO">30</field>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="botao_se_apertado">
            <field name="BOTAO">B</field>
            <statement name="DO">
              <block type="variables_alterar">
                <field name="VAR">codigo</field>
                <value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">codigo</field></block></value>
                <value name="VALUE">
                  <block type="math_arithmetic">
                    <field name="OP">ADD</field>
                    <value name="A">
                      <block type="math_arithmetic">
                        <field name="OP">MULTIPLY</field>
                        <value name="A"><block type="variables_valor_guardado"><field name="VAR">codigo</field></block></value>
                        <value name="B"><block type="math_number"><field name="NUM">10</field></block></value>
                      </block>
                    </value>
                    <value name="B"><block type="math_number"><field name="NUM">2</field></block></value>
                  </block>
                </value>
                <next>
                  <block type="mostrar_numero_matriz">
                    <value name="NUMERO"><block type="numero_matriz_2"></block></value>
                    <value name="COR"><block type="colour_orange"></block></value>
                    <field name="BRILHO">30</field>
                  </block>
                </next>
              </block>
            </statement>
            <next>
              <block type="botao_se_apertado">
                <field name="BOTAO">C</field>
                <statement name="DO">
                  <block type="controls_ifelse">
                    <value name="IF0">
                      <block type="logic_compare">
                        <field name="OP">EQ</field>
                        <value name="A"><block type="variables_valor_guardado"><field name="VAR">codigo</field></block></value>
                        <value name="B"><block type="math_number"><field name="NUM">1212</field></block></value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="matriz_pulsar_brilho">
                        <statement name="DO">
                          <block type="mostrar_emoji">
                            <value name="EMOJI"><block type="emoji_coracao"></block></value>
                            <value name="COR"><block type="colour_green"></block></value>
                            <field name="BRILHO">30</field>
                          </block>
                        </statement>
                      </block>
                    </statement>
                    <statement name="ELSE">
                      <block type="matriz_contracao">
                        <statement name="DO">
                          <block type="mostrar_emoji">
                            <value name="EMOJI"><block type="emoji_fantasma"></block></value>
                            <value name="COR"><block type="colour_red"></block></value>
                            <field name="BRILHO">30</field>
                          </block>
                        </statement>
                      </block>
                    </statement>
                    <next>
                      <block type="esperar_segundos">
                        <value name="TIME"><block type="math_number"><field name="NUM">2</field></block></value>
                        <next>
                          <block type="variables_alterar">
                            <field name="VAR">codigo</field>
                            <value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">codigo</field></block></value>
                            <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
                            <next>
                              <block type="desligar_matriz"></block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>


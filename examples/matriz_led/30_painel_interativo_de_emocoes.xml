<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="mostrar_emoji" x="30" y="30">
    <!-- Painel de emoções: A mostra alegria, B mostra tristeza e C mostra surpresa. Cada escolha usa um efeito visual diferente. -->
    <value name="EMOJI"><block type="emoji_coracao"></block></value>
    <value name="COR"><block type="colour_pink"></block></value>
    <field name="BRILHO">55</field>
    <next>
      <block type="botao_se_apertado">
        <field name="BOTAO">A</field>
        <statement name="DO">
          <block type="matriz_aparecer_sumir">
            <statement name="DO">
              <block type="mostrar_emoji">
                <value name="EMOJI"><block type="emoji_rosto_feliz"></block></value>
                <value name="COR"><block type="colour_green"></block></value>
                <field name="BRILHO">75</field>
              </block>
            </statement>
          </block>
        </statement>
        <next>
          <block type="botao_se_apertado">
            <field name="BOTAO">B</field>
            <statement name="DO">
              <block type="matriz_piscar_lento">
                <statement name="DO">
                  <block type="mostrar_emoji">
                    <value name="EMOJI"><block type="emoji_rosto_triste"></block></value>
                    <value name="COR"><block type="colour_skyblue"></block></value>
                    <field name="BRILHO">70</field>
                  </block>
                </statement>
              </block>
            </statement>
            <next>
              <block type="botao_se_apertado">
                <field name="BOTAO">C</field>
                <statement name="DO">
                  <block type="matriz_dar_flash">
                    <value name="COR"><block type="colour_white"></block></value>
                    <statement name="DO">
                      <block type="mostrar_emoji">
                        <value name="EMOJI"><block type="emoji_rosto_surpreso"></block></value>
                        <value name="COR"><block type="colour_yellow"></block></value>
                        <field name="BRILHO">80</field>
                      </block>
                    </statement>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>


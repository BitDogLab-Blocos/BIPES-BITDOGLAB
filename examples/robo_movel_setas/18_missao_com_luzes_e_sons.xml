<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- O botao A inicia uma missao com sinal de partida, rota, matriz e som de chegada. -->
  <block type="robo_setas_iniciar" x="30" y="30">
    <next><block type="botao_se_apertado">
      <field name="BOTAO">A</field>
      <statement name="DO"><block type="bipe_curto">
        <field name="VOLUME">35</field>
        <next><block type="mostrar_emoji">
          <field name="BRILHO">25</field>
          <value name="EMOJI"><block type="emoji_seta_cima"></block></value>
          <value name="COR"><block type="colour_blue"></block></value>
          <next><block type="robo_setas_frente">
            <next><block type="robo_setas_direita">
              <next><block type="robo_setas_frente">
                <next><block type="mostrar_emoji">
                  <field name="BRILHO">25</field>
                  <value name="EMOJI"><block type="emoji_rosto_feliz"></block></value>
                  <value name="COR"><block type="colour_green"></block></value>
                  <next><block type="som_de_sucesso">
                    <field name="VOLUME">35</field>
                    <next><block type="robo_setas_finalizar"></block></next>
                  </block></next>
                </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block></statement>
    </block></next>
  </block>
</xml>

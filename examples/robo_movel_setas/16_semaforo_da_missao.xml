<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- O botao A inicia; verde libera o caminho e vermelho sinaliza a chegada. -->
  <block type="robo_setas_iniciar" x="30" y="30">
    <next><block type="botao_se_apertado">
      <field name="BOTAO">A</field>
      <statement name="DO"><block type="bloco_ligar_led">
        <value name="COLOUR"><block type="colour_green"></block></value>
        <next><block type="robo_setas_frente">
          <next><block type="robo_setas_direita">
            <next><block type="bloco_ligar_led">
              <value name="COLOUR"><block type="colour_red"></block></value>
              <next><block type="robo_setas_finalizar"></block></next>
            </block></next>
          </block></next>
        </block></next>
      </block></statement>
    </block></next>
  </block>
</xml>

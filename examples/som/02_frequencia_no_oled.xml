<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Projeto de sintetizador: o joystick muda a frequência, a variável guarda o valor e o OLED o mostra. -->
  <block type="variables_guardar" x="30" y="30">
    <field name="VAR">frequencia</field><value name="VALUE"><block type="math_number"><field name="NUM">1000</field></block></value>
    <next>
      <block type="joystick_controlar_buzzer"><field name="FREQ_INICIAL">1000</field><field name="VOLUME">30</field><field name="DIR_AUMENTAR">UP</field><field name="DIR_DIMINUIR">DOWN</field>
        <next>
          <block type="variables_alterar"><field name="VAR">frequencia</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">frequencia</field></block></value><value name="VALUE"><block type="joystick_frequencia_atual"></block></value>
            <next>
              <block type="display_limpar"><field name="DISPLAY_TYPE">SMALL</field>
                <next><block type="display_texto"><field name="TEXTO">Freq Hz:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
                  <next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">frequencia</field></block></value>
                    <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">150</field></block></value></block></next>
                  </block></next>
                </block></next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

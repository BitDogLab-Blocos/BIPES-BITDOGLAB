<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Projeto final: contador, OLED, LED e notas formam uma pequena apresentação. -->
  <block type="variables_guardar" x="30" y="30">
    <field name="VAR">etapa</field>
    <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next>
      <block type="controls_repeat_simple"><field name="TIMES">4</field>
        <statement name="DO">
          <block type="variables_adicionar"><field name="VAR">etapa</field><value name="AMOUNT"><block type="math_number"><field name="NUM">1</field></block></value>
            <next>
              <block type="display_limpar"><field name="DISPLAY_TYPE">SMALL</field>
                <next>
                  <block type="display_texto"><field name="TEXTO">Etapa:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
                    <next>
                      <block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">etapa</field></block></value>
                        <next>
                          <block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_blue"></block></value>
                            <next>
                              <block type="tocar_nota"><value name="NOTA"><block type="nota_sol"></block></value><field name="OCTAVE">4</field><field name="VOLUME">30</field><field name="DURATION">350</field>
                                <next>
                                  <block type="esperar_segundos"><value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
                                    <next>
                                      <block type="bloco_desligar_led"><value name="COLOUR"><block type="colour_blue"></block></value>
                                        <next><block type="esperar_segundos"><value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value></block></next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>

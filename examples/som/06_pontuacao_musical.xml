<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Projeto com memória: A, B e C somam pontos diferentes e respondem com notas. -->
  <block type="variables_guardar" x="30" y="30">
    <field name="VAR">rodada</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next>
      <block type="botao_se_apertado"><field name="BOTAO">A</field>
        <statement name="DO"><block type="variables_adicionar"><field name="VAR">rodada</field><value name="AMOUNT"><block type="math_number"><field name="NUM">1</field></block></value>
          <next><block type="tocar_nota"><value name="NOTA"><block type="nota_fa"></block></value><field name="OCTAVE">4</field><field name="VOLUME">30</field><field name="DURATION">300</field><next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">350</field></block></value></block></next></block></next>
        </block></statement>
        <next>
          <block type="botao_se_apertado"><field name="BOTAO">B</field>
            <statement name="DO"><block type="variables_adicionar"><field name="VAR">rodada</field><value name="AMOUNT"><block type="math_number"><field name="NUM">2</field></block></value>
              <next><block type="tocar_nota"><value name="NOTA"><block type="nota_la"></block></value><field name="OCTAVE">4</field><field name="VOLUME">30</field><field name="DURATION">300</field><next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">350</field></block></value></block></next></block></next>
            </block></statement>
            <next>
              <block type="botao_se_apertado"><field name="BOTAO">C</field>
                <statement name="DO"><block type="variables_adicionar"><field name="VAR">rodada</field><value name="AMOUNT"><block type="math_number"><field name="NUM">3</field></block></value>
                  <next><block type="tocar_nota"><value name="NOTA"><block type="nota_si"></block></value><field name="OCTAVE">5</field><field name="VOLUME">30</field><field name="DURATION">300</field><next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">350</field></block></value></block></next></block></next>
                </block></statement>
                <next><block type="display_limpar"><field name="DISPLAY_TYPE">SMALL</field><next><block type="display_texto"><field name="TEXTO">Rodada:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field><next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">rodada</field></block></value><next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">200</field></block></value></block></next></block></next></block></next></block></next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

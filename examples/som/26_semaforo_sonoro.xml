<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Projeto integrado: três cores e três sons contam uma sequência de semáforo. -->
  <block type="controls_repeat_simple" x="30" y="30">
    <field name="TIMES">2</field>
    <statement name="DO">
      <block type="bloco_ligar_led">
        <value name="COLOUR"><block type="colour_red"></block></value>
        <next>
          <block type="som_de_falha"><field name="VOLUME">30</field>
            <next>
              <block type="esperar_segundos"><value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
                <next>
                  <block type="bloco_desligar_led"><value name="COLOUR"><block type="colour_red"></block></value>
                    <next>
                      <block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_yellow"></block></value>
                        <next>
                          <block type="bipe_duplo"><field name="VOLUME">30</field>
                            <next>
                              <block type="esperar_segundos"><value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
                                <next>
                                  <block type="bloco_desligar_led"><value name="COLOUR"><block type="colour_yellow"></block></value>
                                    <next>
                                      <block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_green"></block></value>
                                        <next>
                                          <block type="som_de_sucesso"><field name="VOLUME">30</field>
                                            <next>
                                              <block type="esperar_segundos"><value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
                                                <next>
                                                  <block type="bloco_desligar_led"><value name="COLOUR"><block type="colour_green"></block></value>
                                                    <next>
                                                      <block type="esperar_segundos"><value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value></block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>

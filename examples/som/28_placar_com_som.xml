<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Projeto com variável: A soma acertos, B tira pontos e o OLED mostra o estado. -->
  <block type="variables_guardar" x="30" y="30">
    <field name="VAR">pontos</field>
    <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next>
      <block type="botao_se_apertado"><field name="BOTAO">A</field>
        <statement name="DO">
          <block type="variables_adicionar"><field name="VAR">pontos</field><value name="AMOUNT"><block type="math_number"><field name="NUM">1</field></block></value>
            <next><block type="som_de_sucesso"><field name="VOLUME">30</field><next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">400</field></block></value></block></next></block></next>
          </block>
        </statement>
        <next>
          <block type="botao_se_apertado"><field name="BOTAO">B</field>
            <statement name="DO">
              <block type="variables_tirar"><field name="VAR">pontos</field><value name="AMOUNT"><block type="math_number"><field name="NUM">1</field></block></value>
                <next><block type="som_de_falha"><field name="VOLUME">30</field><next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">400</field></block></value></block></next></block></next>
              </block>
            </statement>
            <next>
              <block type="display_limpar"><field name="DISPLAY_TYPE">SMALL</field>
                <next>
                  <block type="display_texto"><field name="TEXTO">Pontos:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
                    <next>
                      <block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">pontos</field></block></value>
                        <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">250</field></block></value></block></next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

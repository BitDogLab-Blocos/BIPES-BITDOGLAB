<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- O estudante cria uma resposta: A toca uma pergunta curta e B responde mais agudo. -->
  <block type="display_limpar" x="30" y="30"><field name="DISPLAY_TYPE">SMALL</field><next>
    <block type="botao_se_apertado"><field name="BOTAO">A</field><statement name="DO"><block type="display_texto"><field name="TEXTO">Pergunta</field><field name="LINHA">1</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field><next><block type="criar_melodia"><mutation note_steps="3"></mutation><value name="NOTA0"><block type="nota_do"></block></value><value name="TEMPO0"><block type="tempo_milisegundos"><field name="NUM">200</field></block></value><value name="NOTA1"><block type="nota_re"></block></value><value name="TEMPO1"><block type="tempo_milisegundos"><field name="NUM">200</field></block></value><value name="NOTA2"><block type="nota_mi"></block></value><value name="TEMPO2"><block type="tempo_milisegundos"><field name="NUM">350</field></block></value></block></next></block></statement><next>
      <block type="botao_se_apertado"><field name="BOTAO">B</field><statement name="DO"><block type="display_texto"><field name="TEXTO">Resposta</field><field name="LINHA">1</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field><next><block type="criar_melodia"><mutation note_steps="3"></mutation><value name="NOTA0"><block type="nota_sol"></block></value><value name="TEMPO0"><block type="tempo_milisegundos"><field name="NUM">200</field></block></value><value name="NOTA1"><block type="nota_la"></block></value><value name="TEMPO1"><block type="tempo_milisegundos"><field name="NUM">200</field></block></value><value name="NOTA2"><block type="nota_si"></block></value><value name="TEMPO2"><block type="tempo_milisegundos"><field name="NUM">350</field></block></value></block></next></block></statement><next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">300</field></block></value></block></next></block>
    </next></block>
  </next></block>
</xml>

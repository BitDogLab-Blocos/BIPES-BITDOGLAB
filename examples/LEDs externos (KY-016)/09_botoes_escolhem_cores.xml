<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- A escolhe vermelho, B escolhe verde e C escolhe azul. Nunca repita a Conexão. -->
  <block type="botao_se_apertado" x="20" y="20"><field name="BOTAO">A</field>
    <statement name="DO"><block type="led_externo_ligar"><field name="CHANNEL">R</field><field name="DIG">0</field><next><block type="esperar_segundos"><value name="TIME"><block type="tempo_segundos"><field name="NUM">1</field></block></value><next><block type="led_externo_desligar"><field name="CHANNEL">R</field><field name="DIG">0</field></block></next></block></next></block></statement>
    <next><block type="botao_se_apertado"><field name="BOTAO">B</field>
      <statement name="DO"><block type="led_externo_ligar"><field name="CHANNEL">G</field><field name="DIG">1</field><next><block type="esperar_segundos"><value name="TIME"><block type="tempo_segundos"><field name="NUM">1</field></block></value><next><block type="led_externo_desligar"><field name="CHANNEL">G</field><field name="DIG">1</field></block></next></block></next></block></statement>
      <next><block type="botao_se_apertado"><field name="BOTAO">C</field>
        <statement name="DO"><block type="led_externo_ligar"><field name="CHANNEL">B</field><field name="DIG">2</field><next><block type="esperar_segundos"><value name="TIME"><block type="tempo_segundos"><field name="NUM">1</field></block></value><next><block type="led_externo_desligar"><field name="CHANNEL">B</field><field name="DIG">2</field></block></next></block></next></block></statement>
      </block></next>
    </block></next>
  </block>
</xml>

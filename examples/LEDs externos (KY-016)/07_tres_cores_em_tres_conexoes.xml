<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- R, G e B são acesos separadamente para ensinar a identificação dos pinos. -->
  <block type="led_externo_ligar" x="20" y="20"><field name="CHANNEL">R</field><field name="DIG">0</field>
    <next><block type="esperar_segundos"><value name="TIME"><block type="tempo_segundos"><field name="NUM">1</field></block></value>
      <next><block type="led_externo_desligar"><field name="CHANNEL">R</field><field name="DIG">0</field>
        <next><block type="led_externo_ligar"><field name="CHANNEL">G</field><field name="DIG">1</field>
          <next><block type="esperar_segundos"><value name="TIME"><block type="tempo_segundos"><field name="NUM">1</field></block></value>
            <next><block type="led_externo_desligar"><field name="CHANNEL">G</field><field name="DIG">1</field>
              <next><block type="led_externo_ligar"><field name="CHANNEL">B</field><field name="DIG">2</field>
                <next><block type="esperar_segundos"><value name="TIME"><block type="tempo_segundos"><field name="NUM">1</field></block></value>
                  <next><block type="led_externo_desligar"><field name="CHANNEL">B</field><field name="DIG">2</field></block></next>
                </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Pressione o botão A: o vermelho acende, espera e apaga. -->
  <block type="botao_se_apertado" x="20" y="20"><field name="BOTAO">A</field>
    <statement name="DO"><block type="led_externo_ligar"><field name="CHANNEL">R</field><field name="DIG">0</field>
      <next><block type="esperar_segundos"><value name="TIME"><block type="tempo_segundos"><field name="NUM">2</field></block></value>
        <next><block type="led_externo_desligar"><field name="CHANNEL">R</field><field name="DIG">0</field></block></next>
      </block></next>
    </block></statement>
  </block>
</xml>

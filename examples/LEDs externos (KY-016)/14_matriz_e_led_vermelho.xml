      <next><block type="esperar_segundos"><value name="TIME"><block type="tempo_segundos"><field name="NUM">4</field></block></value>
        <next><block type="led_externo_desligar"><field name="CHANNEL">R</field><field name="DIG">1</field>
          <next><block type="esperar_segundos"><value name="TIME"><block type="tempo_segundos"><field name="NUM">1</field></block></value>
            <next><block type="desligar_matriz">
              <next><block type="esperar_segundos"><value name="TIME"><block type="tempo_segundos"><field name="NUM">1</field></block></value></block></next>
            </block></next>
          </block></next>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Mova o joystick para controlar o servo; o LED verde indica que o modo está ativo. -->
  <block type="servo_joystick_controlar" x="20" y="20"><field name="DIG">0</field><field name="INITIAL_ANGLE">90</field><field name="DIR_INCREASE">UP</field><field name="DIR_DECREASE">DOWN</field><field name="STEP">5</field>
    <next><block type="led_externo_ligar"><field name="CHANNEL">G</field><field name="DIG">1</field>
      <next><block type="esperar_segundos"><value name="TIME"><block type="tempo_segundos"><field name="NUM">10</field></block></value>
        <next><block type="led_externo_desligar"><field name="CHANNEL">G</field><field name="DIG">1</field></block></next>
      </block></next>
    </block></next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Desafio final: variavel, servo, microfone, botoes, matriz, som e os tres canais externos. -->
  <block type="variables_guardar" x="20" y="20"><field name="VAR">modo</field><value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next><block type="servo_joystick_controlar"><field name="DIG">0</field><field name="INITIAL_ANGLE">90</field><field name="DIR_INCREASE">UP</field><field name="DIR_DECREASE">DOWN</field><field name="STEP">5</field>
      <next><block type="microfone_vu_meter"><field name="BRILHO">30</field><value name="COR"><block type="colour_blue"></block></value>
        <next><block type="led_externo_desligar"><field name="CHANNEL">R</field><field name="DIG">1</field>
          <next><block type="led_externo_desligar"><field name="CHANNEL">G</field><field name="DIG">2</field>
            <next><block type="led_externo_desligar"><field name="CHANNEL">B</field><field name="DIG">3</field>
              <next><block type="controls_ifelse"><value name="IF0"><block type="logic_compare"><field name="OP">GT</field><value name="A"><block type="microfone_nivel_atual"></block></value><value name="B"><block type="math_number"><field name="NUM">3</field></block></value></block></value>
                <statement name="DO0"><block type="led_externo_ligar"><field name="CHANNEL">R</field><field name="DIG">1</field><next><block type="mostrar_emoji"><field name="BRILHO">30</field><value name="EMOJI"><block type="emoji_rosto_surpreso"></block></value><value name="COR"><block type="colour_red"></block></value><next><block type="bipe_duplo"><field name="VOLUME">40</field></block></next></block></next></block></statement>
                <statement name="ELSE"><block type="controls_ifelse"><value name="IF0"><block type="logic_compare"><field name="OP">LT</field><value name="A"><block type="servo_angulo_atual"><field name="DIG">0</field></block></value><value name="B"><block type="math_number"><field name="NUM">60</field></block></value></block></value>
                  <statement name="DO0"><block type="led_externo_ligar"><field name="CHANNEL">G</field><field name="DIG">2</field><next><block type="mostrar_emoji"><field name="BRILHO">30</field><value name="EMOJI"><block type="emoji_rosto_feliz"></block></value><value name="COR"><block type="colour_green"></block></value></block></next></block></statement>
                  <statement name="ELSE"><block type="led_externo_ligar"><field name="CHANNEL">B</field><field name="DIG">3</field><next><block type="mostrar_emoji"><field name="BRILHO">30</field><value name="EMOJI"><block type="emoji_coracao"></block></value><value name="COR"><block type="colour_blue"></block></value></block></next></block></statement>
                </block></statement>
                <next><block type="botao_se_apertado"><field name="BOTAO">A</field><statement name="DO"><block type="variables_alterar"><field name="VAR">modo</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">modo</field></block></value><value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value><next><block type="bipe_curto"><field name="VOLUME">25</field></block></next></block></statement>
                  <next><block type="esperar_segundos"><value name="TIME"><block type="tempo_segundos"><field name="NUM">1</field></block></value></block></next>
                </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

    <field name="CHANNEL">B</field><field name="DIG">2</field>
    <next><block type="esperar_segundos"><value name="TIME"><block type="tempo_segundos"><field name="NUM">5</field></block></value>
      <next><block type="led_externo_desligar"><field name="CHANNEL">B</field><field name="DIG">2</field>
        <next><block type="esperar_segundos"><value name="TIME"><block type="tempo_segundos"><field name="NUM">1</field></block></value></block></next>
      </block></next>
    </block></next>
  </block>
</xml>

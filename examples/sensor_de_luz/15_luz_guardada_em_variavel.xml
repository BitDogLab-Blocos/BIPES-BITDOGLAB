<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- A leitura fica guardada na variavel para ser usada no display e na decisao. -->
  <block type="variables_guardar" x="20" y="20">
    <field name="VAR">luz</field>
    <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next>
      <block type="variables_alterar">
        <field name="VAR">luz</field>
        <value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">luz</field></block></value>
        <value name="VALUE"><block type="ldr_valor"><field name="CONNECTION">ANA-IN</field></block></value>
        <next>
          <block type="display_texto"><field name="TEXTO">Luz atual (%):</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
            <next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">luz</field></block></value>
              <next><block type="controls_ifelse">
                <value name="IF0"><block type="logic_compare"><field name="OP">GTE</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">luz</field></block></value><value name="B"><block type="math_number"><field name="NUM">60</field></block></value></block></value>
                <statement name="DO0"><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_green"></block></value></block></statement>
                <statement name="ELSE"><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_blue"></block></value></block></statement>
              </block></next>
            </block></next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Enquanto A estiver pressionado, a luz escolhe a posicao do servo; ao soltar, ele vai para o centro. -->
  <block type="display_texto" x="20" y="20">
    <field name="TEXTO">Luz (%):</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
    <next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="ldr_valor"><field name="CONNECTION">ANA-IN</field></block></value>
      <next><block type="botao_enquanto_apertado"><field name="BOTAO">A</field>
        <statement name="DO"><block type="controls_ifelse"><value name="IF0"><block type="logic_compare"><field name="OP">GTE</field><value name="A"><block type="ldr_valor"><field name="CONNECTION">ANA-IN</field></block></value><value name="B"><block type="math_number"><field name="NUM">60</field></block></value></block></value><statement name="DO0"><block type="servo_mover"><field name="DIG">0</field><field name="ANGLE">0</field><next><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_green"></block></value></block></next></block></statement><statement name="ELSE"><block type="servo_mover"><field name="DIG">0</field><field name="ANGLE">180</field><next><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_blue"></block></value></block></next></block></statement></block></statement>
        <statement name="ELSE"><block type="servo_mover"><field name="DIG">0</field><field name="ANGLE">90</field></block></statement>
      </block></next>
    </block></next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Painel de observacao: valor numerico na parte superior e grafico na parte inferior. -->
  <block type="display_texto" x="20" y="20">
    <field name="TEXTO">Leitura:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
    <next><block type="display_mostrar_valor">
      <field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
      <value name="VALOR"><block type="ldr_valor"><field name="CONNECTION">ANA-IN</field></block></value>
      <next><block type="ldr_plotar">
        <field name="POSICAO">2</field><field name="DISPLAY_TYPE">SMALL</field>
        <value name="VALOR"><block type="ldr_valor"><field name="CONNECTION">ANA-IN</field></block></value>
      </block></next>
    </block></next>
  </block>
</xml>

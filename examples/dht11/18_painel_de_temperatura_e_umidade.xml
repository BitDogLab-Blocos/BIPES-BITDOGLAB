<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Painel simples: valores no topo, grafico na metade de baixo e LEDs conforme a temperatura. -->
  <block x="20" y="20" type="display_texto">
        <field name="TEXTO">Temp:</field>
        <field name="LINHA">1</field>
        <field name="ALINHAMENTO">LEFT</field>
        <field name="DISPLAY_TYPE">SMALL</field>
        <next>
          <block type="display_mostrar_valor">
            <field name="LINHA">1</field>
            <field name="ALINHAMENTO">RIGHT</field>
            <field name="DISPLAY_TYPE">SMALL</field>
            <value name="VALOR">
              <block type="dht11_temperatura"><field name="DIG">0</field></block>
            </value>
            <next>
              <block type="display_texto">
                <field name="TEXTO">Umid:</field>
                <field name="LINHA">2</field>
                <field name="ALINHAMENTO">LEFT</field>
                <field name="DISPLAY_TYPE">SMALL</field>
                <next>
                  <block type="display_mostrar_valor">
                    <field name="LINHA">2</field>
                    <field name="ALINHAMENTO">RIGHT</field>
                    <field name="DISPLAY_TYPE">SMALL</field>
                    <value name="VALOR">
                      <block type="dht11_umidade"><field name="DIG">0</field></block>
                    </value>
                    <next>
                      <block type="controls_ifelse">
                        <value name="IF0">
                          <block type="logic_compare">
                            <field name="OP">GT</field>
                            <value name="A"><block type="dht11_temperatura"><field name="DIG">0</field></block></value>
                            <value name="B"><block type="math_number"><field name="NUM">30</field></block></value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_red"></block></value></block>
                        </statement>
                        <statement name="ELSE">
                          <block type="controls_ifelse">
                            <value name="IF0">
                              <block type="logic_compare">
                                <field name="OP">LT</field>
                                <value name="A"><block type="dht11_temperatura"><field name="DIG">0</field></block></value>
                                <value name="B"><block type="math_number"><field name="NUM">18</field></block></value>
                              </block>
                            </value>
                            <statement name="DO0">
                              <block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_blue"></block></value></block>
                            </statement>
                            <statement name="ELSE">
                              <block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_green"></block></value></block>
                            </statement>
                          </block>
                        </statement>
                        <next>
                          <block type="dht11_plotar">
                            <field name="POSICAO">2</field>
                            <field name="DISPLAY_TYPE">SMALL</field>
                            <value name="VALOR">
                              <block type="dht11_temperatura"><field name="DIG">0</field></block>
                            </value>
                            <next>
                              <block type="esperar_segundos">
                                <value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Mostra vermelho, verde e azul: as três cores primárias usadas pelos LEDs RGB. -->
  <block type="preencher_matriz" x="20" y="20">
    <field name="INTENSITY">55</field>
    <value name="COLOUR"><block type="colour_red"></block></value>
    <next>
      <block type="esperar_segundos">
        <value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
        <next>
          <block type="preencher_matriz">
            <field name="INTENSITY">55</field>
            <value name="COLOUR"><block type="colour_green"></block></value>
            <next>
              <block type="esperar_segundos">
                <value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
                <next>
                  <block type="preencher_matriz">
                    <field name="INTENSITY">55</field>
                    <value name="COLOUR"><block type="colour_blue"></block></value>
                    <next>
                      <block type="esperar_segundos">
                        <value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

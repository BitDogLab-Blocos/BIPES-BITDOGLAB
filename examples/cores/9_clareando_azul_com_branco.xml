<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Compara azul puro, azul misturado com branco e azul-celeste para estudar tons mais claros. -->
  <block type="bloco_ligar_led" x="20" y="20">
    <value name="COLOUR"><block type="colour_blue"></block></value>
    <next>
      <block type="esperar_segundos">
        <value name="TIME"><block type="math_number"><field name="NUM">2</field></block></value>
        <next>
          <block type="bloco_ligar_led">
            <value name="COLOUR">
              <block type="mix_colours">
                <mutation items="2"></mutation>
                <value name="ADD0"><block type="colour_blue"></block></value>
                <value name="ADD1"><block type="colour_white"></block></value>
              </block>
            </value>
            <next>
              <block type="esperar_segundos">
                <value name="TIME"><block type="math_number"><field name="NUM">2</field></block></value>
                <next>
                  <block type="bloco_ligar_led">
                    <value name="COLOUR"><block type="colour_skyblue"></block></value>
                    <next>
                      <block type="esperar_segundos">
                        <value name="TIME"><block type="math_number"><field name="NUM">2</field></block></value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

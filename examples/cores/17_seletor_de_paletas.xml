<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Seletor de paletas: A monta cores quentes, B monta cores frias e C mostra uma luz branca neutra. -->
  <block type="botao_se_apertado" x="20" y="20">
    <field name="BOTAO">A</field>
    <statement name="DO">
      <block type="criar_desenho_na_matriz">
        <mutation items="4"></mutation>
        <statement name="DESENHO0">
          <block type="acender_linha">
            <field name="LINHA">0</field><field name="INTENSITY">55</field>
            <value name="COLOUR"><block type="colour_red"></block></value>
          </block>
        </statement>
        <statement name="DESENHO1">
          <block type="acender_linha">
            <field name="LINHA">1</field><field name="INTENSITY">55</field>
            <value name="COLOUR"><block type="colour_orange"></block></value>
          </block>
        </statement>
        <statement name="DESENHO2">
          <block type="acender_linha">
            <field name="LINHA">2</field><field name="INTENSITY">55</field>
            <value name="COLOUR"><block type="colour_yellow"></block></value>
          </block>
        </statement>
        <statement name="DESENHO3">
          <block type="acender_linha">
            <field name="LINHA">3</field><field name="INTENSITY">55</field>
            <value name="COLOUR"><block type="colour_pink"></block></value>
          </block>
        </statement>
      </block>
    </statement>
    <next>
      <block type="botao_se_apertado">
        <field name="BOTAO">B</field>
        <statement name="DO">
          <block type="criar_desenho_na_matriz">
            <mutation items="5"></mutation>
            <statement name="DESENHO0">
              <block type="acender_linha">
                <field name="LINHA">0</field><field name="INTENSITY">50</field>
                <value name="COLOUR"><block type="colour_blue"></block></value>
              </block>
            </statement>
            <statement name="DESENHO1">
              <block type="acender_linha">
                <field name="LINHA">1</field><field name="INTENSITY">50</field>
                <value name="COLOUR"><block type="colour_skyblue"></block></value>
              </block>
            </statement>
            <statement name="DESENHO2">
              <block type="acender_linha">
                <field name="LINHA">2</field><field name="INTENSITY">50</field>
                <value name="COLOUR"><block type="colour_cyan"></block></value>
              </block>
            </statement>
            <statement name="DESENHO3">
              <block type="acender_linha">
                <field name="LINHA">3</field><field name="INTENSITY">50</field>
                <value name="COLOUR"><block type="colour_turquoise"></block></value>
              </block>
            </statement>
            <statement name="DESENHO4">
              <block type="acender_linha">
                <field name="LINHA">4</field><field name="INTENSITY">50</field>
                <value name="COLOUR"><block type="colour_lime"></block></value>
              </block>
            </statement>
          </block>
        </statement>
        <next>
          <block type="botao_se_apertado">
            <field name="BOTAO">C</field>
            <statement name="DO">
              <block type="preencher_matriz">
                <field name="INTENSITY">40</field>
                <value name="COLOUR"><block type="colour_white"></block></value>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

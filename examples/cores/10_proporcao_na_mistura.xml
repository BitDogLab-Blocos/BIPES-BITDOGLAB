<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Repete o vermelho na mistura para mostrar como a proporção desloca o resultado em direção ao vermelho. -->
  <block type="preencher_matriz" x="20" y="20">
    <field name="INTENSITY">70</field>
    <value name="COLOUR">
      <block type="mix_colours">
        <mutation items="2"></mutation>
        <value name="ADD0"><block type="colour_red"></block></value>
        <value name="ADD1"><block type="colour_blue"></block></value>
      </block>
    </value>
    <next>
      <block type="esperar_segundos">
        <value name="TIME"><block type="math_number"><field name="NUM">2</field></block></value>
        <next>
          <block type="preencher_matriz">
            <field name="INTENSITY">70</field>
            <value name="COLOUR">
              <block type="mix_colours">
                <mutation items="3"></mutation>
                <value name="ADD0"><block type="colour_red"></block></value>
                <value name="ADD1"><block type="colour_red"></block></value>
                <value name="ADD2"><block type="colour_blue"></block></value>
              </block>
            </value>
            <next>
              <block type="esperar_segundos">
                <value name="TIME"><block type="math_number"><field name="NUM">2</field></block></value>
                <next>
                  <block type="preencher_matriz">
                    <field name="INTENSITY">70</field>
                    <value name="COLOUR">
                      <block type="mix_colours">
                        <mutation items="4"></mutation>
                        <value name="ADD0"><block type="colour_red"></block></value>
                        <value name="ADD1"><block type="colour_red"></block></value>
                        <value name="ADD2"><block type="colour_red"></block></value>
                        <value name="ADD3"><block type="colour_blue"></block></value>
                      </block>
                    </value>
                    <next>
                      <block type="esperar_segundos">
                        <value name="TIME"><block type="math_number"><field name="NUM">2</field></block></value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

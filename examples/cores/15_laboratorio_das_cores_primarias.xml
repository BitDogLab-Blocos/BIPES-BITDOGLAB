<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Laboratório interativo: A mostra vermelho, B mostra verde, C mostra azul e o joystick mostra branco. -->
  <block type="botao_se_apertado" x="20" y="20">
    <field name="BOTAO">A</field>
    <statement name="DO">
      <block type="preencher_matriz">
        <field name="INTENSITY">60</field>
        <value name="COLOUR"><block type="colour_red"></block></value>
      </block>
    </statement>
    <next>
      <block type="botao_se_apertado">
        <field name="BOTAO">B</field>
        <statement name="DO">
          <block type="preencher_matriz">
            <field name="INTENSITY">60</field>
            <value name="COLOUR"><block type="colour_green"></block></value>
          </block>
        </statement>
        <next>
          <block type="botao_se_apertado">
            <field name="BOTAO">C</field>
            <statement name="DO">
              <block type="preencher_matriz">
                <field name="INTENSITY">60</field>
                <value name="COLOUR"><block type="colour_blue"></block></value>
              </block>
            </statement>
            <next>
              <block type="botao_se_apertado">
                <field name="BOTAO">JOYSTICK</field>
                <statement name="DO">
                  <block type="preencher_matriz">
                    <field name="INTENSITY">45</field>
                    <value name="COLOUR"><block type="colour_white"></block></value>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Monta uma paleta fria com azul, azul-celeste, ciano, turquesa e verde-limão. -->
  <block type="criar_desenho_na_matriz" x="20" y="20">
    <mutation items="5"></mutation>
    <statement name="DESENHO0">
      <block type="acender_linha">
        <field name="LINHA">0</field><field name="INTENSITY">50</field>
        <value name="COLOUR"><block type="colour_blue"></block></value>
      </block>
    </statement>
    <statement name="DESENHO1">
      <block type="acender_linha">
        <field name="LINHA">1</field><field name="INTENSITY">50</field>
        <value name="COLOUR"><block type="colour_skyblue"></block></value>
      </block>
    </statement>
    <statement name="DESENHO2">
      <block type="acender_linha">
        <field name="LINHA">2</field><field name="INTENSITY">50</field>
        <value name="COLOUR"><block type="colour_cyan"></block></value>
      </block>
    </statement>
    <statement name="DESENHO3">
      <block type="acender_linha">
        <field name="LINHA">3</field><field name="INTENSITY">50</field>
        <value name="COLOUR"><block type="colour_turquoise"></block></value>
      </block>
    </statement>
    <statement name="DESENHO4">
      <block type="acender_linha">
        <field name="LINHA">4</field><field name="INTENSITY">50</field>
        <value name="COLOUR"><block type="colour_lime"></block></value>
      </block>
    </statement>
  </block>
</xml>

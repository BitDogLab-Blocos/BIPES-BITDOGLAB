<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Monta uma paleta quente com vermelho, laranja, amarelo e rosa em linhas da matriz. -->
  <block type="criar_desenho_na_matriz" x="20" y="20">
    <mutation items="4"></mutation>
    <statement name="DESENHO0">
      <block type="acender_linha">
        <field name="LINHA">0</field><field name="INTENSITY">55</field>
        <value name="COLOUR"><block type="colour_red"></block></value>
      </block>
    </statement>
    <statement name="DESENHO1">
      <block type="acender_linha">
        <field name="LINHA">1</field><field name="INTENSITY">55</field>
        <value name="COLOUR"><block type="colour_orange"></block></value>
      </block>
    </statement>
    <statement name="DESENHO2">
      <block type="acender_linha">
        <field name="LINHA">2</field><field name="INTENSITY">55</field>
        <value name="COLOUR"><block type="colour_yellow"></block></value>
      </block>
    </statement>
    <statement name="DESENHO3">
      <block type="acender_linha">
        <field name="LINHA">3</field><field name="INTENSITY">55</field>
        <value name="COLOUR"><block type="colour_pink"></block></value>
      </block>
    </statement>
  </block>
</xml>

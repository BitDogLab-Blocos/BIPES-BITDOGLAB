<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Ligue e apague com dois botões. A acende o LED; B apaga. Cada botão tem uma tarefa. -->
  <block x="30" y="30" type="botao_se_apertado">
    <field name="BOTAO">A</field>
    <statement name="DO">
      <block type="bloco_ligar_led">
        <value name="COLOUR">
          <block type="colour_green">
          </block>
        </value>
      </block>
    </statement>
    <next>
      <block type="botao_se_apertado">
        <field name="BOTAO">B</field>
        <statement name="DO">
          <block type="bloco_desligar_todos_leds">
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>


<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Escolha a cor da luz. A escolhe vermelho; B, azul; C, verde. A cor anterior é apagada. -->
  <block x="30" y="30" type="botao_se_apertado">
    <field name="BOTAO">A</field>
    <statement name="DO">
      <block type="bloco_desligar_todos_leds">
        <next>
          <block type="bloco_ligar_led">
            <value name="COLOUR">
              <block type="colour_red">
              </block>
            </value>
          </block>
        </next>
      </block>
    </statement>
    <next>
      <block type="botao_se_apertado">
        <field name="BOTAO">B</field>
        <statement name="DO">
          <block type="bloco_desligar_todos_leds">
            <next>
              <block type="bloco_ligar_led">
                <value name="COLOUR">
                  <block type="colour_blue">
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="botao_se_apertado">
            <field name="BOTAO">C</field>
            <statement name="DO">
              <block type="bloco_desligar_todos_leds">
                <next>
                  <block type="bloco_ligar_led">
                    <value name="COLOUR">
                      <block type="colour_green">
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>


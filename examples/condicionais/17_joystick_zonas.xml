<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Zonas do joystick: primeiro atualiza o valor X no OLED; depois escolhe o emoji da matriz. -->
  <block type="variables_guardar" x="30" y="30">
    <field name="VAR">posicao_x</field>
    <value name="VALUE">
      <block type="math_number"><field name="NUM">0</field></block>
    </value>
    <next>
      <block type="variables_alterar">
        <field name="VAR">posicao_x</field>
        <value name="TARGET">
          <block type="variables_valor_guardado"><field name="VAR">posicao_x</field></block>
        </value>
        <value name="VALUE"><block type="joystick_posicao_x"></block></value>
        <next>
          <block type="display_limpar">
            <field name="DISPLAY_TYPE">SMALL</field>
            <next>
              <block type="display_texto">
                <field name="TEXTO">X:</field>
                <field name="LINHA">1</field>
                <field name="ALINHAMENTO">LEFT</field>
                <field name="DISPLAY_TYPE">SMALL</field>
                <next>
                  <block type="display_mostrar_valor">
                    <field name="LINHA">1</field>
                    <field name="ALINHAMENTO">RIGHT</field>
                    <field name="DISPLAY_TYPE">SMALL</field>
                    <value name="VALOR">
                      <block type="variables_valor_guardado"><field name="VAR">posicao_x</field></block>
                    </value>
                    <next>
                      <block type="controls_ifelse">
                        <value name="IF0">
                          <block type="logic_compare">
                            <field name="OP">LT</field>
                            <value name="A">
                              <block type="variables_valor_guardado"><field name="VAR">posicao_x</field></block>
                            </value>
                            <value name="B"><block type="math_number"><field name="NUM">42</field></block></value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="mostrar_emoji">
                            <value name="EMOJI"><block type="emoji_rosto_triste"></block></value>
                            <value name="COR"><block type="colour_blue"></block></value>
                            <field name="BRILHO">30</field>
                          </block>
                        </statement>
                        <statement name="ELSE">
                          <block type="controls_ifelse">
                            <value name="IF0">
                              <block type="logic_compare">
                                <field name="OP">GT</field>
                                <value name="A">
                                  <block type="variables_valor_guardado"><field name="VAR">posicao_x</field></block>
                                </value>
                                <value name="B"><block type="math_number"><field name="NUM">84</field></block></value>
                              </block>
                            </value>
                            <statement name="DO0">
                              <block type="mostrar_emoji">
                                <value name="EMOJI"><block type="emoji_rosto_surpreso"></block></value>
                                <value name="COR"><block type="colour_green"></block></value>
                                <field name="BRILHO">30</field>
                              </block>
                            </statement>
                            <statement name="ELSE">
                              <block type="mostrar_emoji">
                                <value name="EMOJI"><block type="emoji_rosto_feliz"></block></value>
                                <value name="COR"><block type="colour_yellow"></block></value>
                                <field name="BRILHO">30</field>
                              </block>
                            </statement>
                          </block>
                        </statement>
                        <next>
                          <block type="esperar_milisegundos">
                            <value name="TIME"><block type="math_number"><field name="NUM">250</field></block></value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

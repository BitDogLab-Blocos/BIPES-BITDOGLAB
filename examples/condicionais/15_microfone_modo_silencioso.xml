<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Limiar de som: acima de 3 o sistema sinaliza alerta; abaixo disso mantém o LED verde. -->
  <block type="variables_guardar" x="30" y="30">
    <field name="VAR">som</field>
    <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next>
      <block type="microfone_vu_meter">
        <field name="BRILHO">30</field><value name="COR"><block type="colour_blue"></block></value>
        <next>
          <block type="variables_alterar"><field name="VAR">som</field><value name="TARGET"><block type="variables_valor_guardado"><field name="VAR">som</field></block></value><value name="VALUE"><block type="microfone_nivel_atual"></block></value>
            <next>
              <block type="controls_ifelse">
                <value name="IF0"><block type="logic_compare"><field name="OP">GT</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">som</field></block></value><value name="B"><block type="math_number"><field name="NUM">3</field></block></value></block></value>
                <statement name="DO0"><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_red"></block></value><next><block type="bipe_duplo"><field name="VOLUME">35</field></block></next></block></statement>
                <statement name="ELSE"><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_green"></block></value></block></statement>
                <next><block type="display_limpar"><field name="DISPLAY_TYPE">SMALL</field><next><block type="display_texto"><field name="TEXTO">Som:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field><next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">som</field></block></value><next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">500</field></block></value></block></next></block></next></block></next></block></next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

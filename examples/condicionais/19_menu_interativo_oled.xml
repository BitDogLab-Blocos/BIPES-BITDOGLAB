<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Menu simples: cada toque em A avança a opção e o Se/Senão informa a escolha no OLED. -->
  <block type="variables_guardar" x="30" y="30">
    <field name="VAR">opcao</field>
    <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next>
      <block type="botao_se_apertado"><field name="BOTAO">A</field><statement name="DO"><block type="variables_adicionar"><field name="VAR">opcao</field><value name="AMOUNT"><block type="math_number"><field name="NUM">1</field></block></value></block></statement>
        <next><block type="display_limpar"><field name="DISPLAY_TYPE">SMALL</field><next><block type="controls_ifelse"><value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">opcao</field></block></value><value name="B"><block type="math_number"><field name="NUM">1</field></block></value></block></value><statement name="DO0"><block type="display_texto"><field name="TEXTO">Modo luz</field><field name="LINHA">1</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field></block></statement><statement name="ELSE"><block type="display_texto"><field name="TEXTO">Modo som</field><field name="LINHA">1</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field></block></statement><next><block type="display_mostrar_valor"><field name="LINHA">2</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">opcao</field></block></value><next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">300</field></block></value></block></next></block></next></block></next></block></next>
      </block>
    </next>
  </block>
</xml>

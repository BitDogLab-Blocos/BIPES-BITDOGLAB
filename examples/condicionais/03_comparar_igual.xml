<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Igualdade: compare dois números para executar uma mensagem quando forem iguais. -->
  <block type="display_limpar" x="30" y="30">
    <field name="DISPLAY_TYPE">SMALL</field>
    <next>
      <block type="controls_ifelse">
        <value name="IF0"><block type="logic_compare"><field name="OP">EQ</field><value name="A"><block type="math_number"><field name="NUM">10</field></block></value><value name="B"><block type="math_number"><field name="NUM">10</field></block></value></block></value>
        <statement name="DO0"><block type="display_texto"><field name="TEXTO">10 igual a 10</field><field name="LINHA">1</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field></block></statement>
        <statement name="ELSE"><block type="display_texto"><field name="TEXTO">Sao diferentes</field><field name="LINHA">1</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field></block></statement>
        <next><block type="esperar_segundos"><value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value></block></next>
      </block>
    </next>
  </block>
</xml>

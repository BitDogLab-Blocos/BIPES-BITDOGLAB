<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Duas faixas: um Se/Senão dentro de outro diferencia bronze, prata e ouro. -->
  <block type="variables_guardar" x="30" y="30">
    <field name="VAR">pontos</field>
    <value name="VALUE"><block type="math_number"><field name="NUM">12</field></block></value>
    <next>
      <block type="controls_ifelse">
        <value name="IF0"><block type="logic_compare"><field name="OP">GTE</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">pontos</field></block></value><value name="B"><block type="math_number"><field name="NUM">20</field></block></value></block></value>
        <statement name="DO0"><block type="display_texto"><field name="TEXTO">Medalha ouro</field><field name="LINHA">1</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field></block></statement>
        <statement name="ELSE"><block type="controls_ifelse"><value name="IF0"><block type="logic_compare"><field name="OP">GTE</field><value name="A"><block type="variables_valor_guardado"><field name="VAR">pontos</field></block></value><value name="B"><block type="math_number"><field name="NUM">10</field></block></value></block></value><statement name="DO0"><block type="display_texto"><field name="TEXTO">Medalha prata</field><field name="LINHA">1</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field></block></statement><statement name="ELSE"><block type="display_texto"><field name="TEXTO">Medalha bronze</field><field name="LINHA">1</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field></block></statement></block></statement>
        <next><block type="display_mostrar_valor"><field name="LINHA">2</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">pontos</field></block></value><next><block type="esperar_segundos"><value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value></block></next></block></next>
      </block>
    </next>
  </block>
</xml>

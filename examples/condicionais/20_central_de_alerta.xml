<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Projeto final: ruído alto OU joystick à direita dispara LED, som, matriz e contador no OLED. -->
  <block type="variables_guardar" x="30" y="30">
    <field name="VAR">alertas</field>
    <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
    <next>
      <block type="microfone_vu_meter"><field name="BRILHO">30</field><value name="COR"><block type="colour_orange"></block></value>
        <next>
          <block type="controls_ifelse">
            <value name="IF0"><block type="logic_operation"><field name="OP">OR</field><value name="A"><block type="logic_compare"><field name="OP">GT</field><value name="A"><block type="microfone_nivel_atual"></block></value><value name="B"><block type="math_number"><field name="NUM">3</field></block></value></block></value><value name="B"><block type="logic_compare"><field name="OP">GT</field><value name="A"><block type="joystick_posicao_x"></block></value><value name="B"><block type="math_number"><field name="NUM">84</field></block></value></block></value></block></value>
            <statement name="DO0"><block type="variables_adicionar"><field name="VAR">alertas</field><value name="AMOUNT"><block type="math_number"><field name="NUM">1</field></block></value><next><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_red"></block></value><next><block type="bipe_duplo"><field name="VOLUME">35</field><next><block type="mostrar_emoji"><value name="EMOJI"><block type="emoji_fantasma"></block></value><value name="COR"><block type="colour_red"></block></value><field name="BRILHO">30</field></block></next></block></next></block></next></block></statement>
            <statement name="ELSE"><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_green"></block></value></block></statement>
            <next><block type="display_limpar"><field name="DISPLAY_TYPE">SMALL</field><next><block type="display_texto"><field name="TEXTO">Alertas:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field><next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field><value name="VALOR"><block type="variables_valor_guardado"><field name="VAR">alertas</field></block></value><next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">500</field></block></value></block></next></block></next></block></next></block></next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

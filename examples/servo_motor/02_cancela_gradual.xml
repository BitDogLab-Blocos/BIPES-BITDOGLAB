<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Cancela: sobe e desce em passos visíveis, mostrando cada mudança de ângulo no OLED. -->
  <block type="display_limpar" x="20" y="20">
    <field name="DISPLAY_TYPE">SMALL</field>
    <next>
      <block type="display_texto">
        <field name="TEXTO">Ang Servo:</field>
        <field name="LINHA">1</field>
        <field name="ALINHAMENTO">LEFT</field>
        <field name="DISPLAY_TYPE">SMALL</field>
        <next>
          <block type="servo_subir_gradualmente">
            <field name="DIG">0</field>
            <field name="TARGET">90</field>
            <field name="STEP">10</field>
            <field name="PAUSE">3</field>
            <statement name="EACH_STEP">
              <block type="display_mostrar_valor">
                <field name="LINHA">1</field>
                <field name="ALINHAMENTO">RIGHT</field>
                <field name="DISPLAY_TYPE">SMALL</field>
                <value name="VALOR">
                  <block type="servo_angulo_atual"><field name="DIG">0</field></block>
                </value>
              </block>
            </statement>
            <next>
              <block type="servo_descer_gradualmente">
                <field name="DIG">0</field>
                <field name="TARGET">0</field>
                <field name="STEP">10</field>
                <field name="PAUSE">3</field>
                <statement name="EACH_STEP">
                  <block type="display_mostrar_valor">
                    <field name="LINHA">1</field>
                    <field name="ALINHAMENTO">RIGHT</field>
                    <field name="DISPLAY_TYPE">SMALL</field>
                    <value name="VALOR">
                      <block type="servo_angulo_atual"><field name="DIG">0</field></block>
                    </value>
                  </block>
                </statement>
                <next>
                  <block type="esperar_segundos">
                    <value name="TIME"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Primeira decisão por ângulo: abaixo de 90 graus o LED fica azul; em 90 graus ou mais fica verde. -->
  <block type="servo_joystick_controlar" x="20" y="20">
    <field name="DIG">0</field><field name="INITIAL_ANGLE">90</field><field name="DIR_INCREASE">UP</field><field name="DIR_DECREASE">DOWN</field><field name="STEP">5</field>
    <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">300</field></block></value>
      <next><block type="display_texto"><field name="TEXTO">Ang Servo:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
          <next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
            <value name="VALOR"><block type="servo_angulo_atual"><field name="DIG">0</field></block></value>
            <next><block type="controls_ifelse">
                <value name="IF0"><block type="logic_compare"><field name="OP">GTE</field><value name="A"><block type="servo_angulo_atual"><field name="DIG">0</field></block></value><value name="B"><block type="math_number"><field name="NUM">90</field></block></value></block></value>
                <statement name="DO0"><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_green"></block></value></block></statement>
                <statement name="ELSE"><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_blue"></block></value></block></statement>
            </block></next>
          </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

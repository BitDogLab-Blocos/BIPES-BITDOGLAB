<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Matemática do movimento: posiciona em 45 graus e calcula no OLED quantos graus ainda faltam para chegar a 180. -->
  <block type="servo_mover" x="20" y="20">
    <field name="DIG">0</field><field name="ANGLE">45</field>
    <next><block type="esperar_segundos"><value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
      <next><block type="display_texto"><field name="TEXTO">Faltam:</field><field name="LINHA">1</field><field name="ALINHAMENTO">LEFT</field><field name="DISPLAY_TYPE">SMALL</field>
        <next><block type="display_mostrar_valor"><field name="LINHA">1</field><field name="ALINHAMENTO">RIGHT</field><field name="DISPLAY_TYPE">SMALL</field>
          <value name="VALOR"><block type="math_arithmetic"><field name="OP">MINUS</field><value name="A"><block type="math_number"><field name="NUM">180</field></block></value><value name="B"><block type="servo_angulo_atual"><field name="DIG">0</field></block></value></block></value>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

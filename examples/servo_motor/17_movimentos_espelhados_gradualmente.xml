<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Coreografia gradual: o servo 0 sobe de 0 a 90 graus e o servo 1 desce de 180 a 90 graus. -->
  <block type="servo_subir_gradualmente" x="20" y="20">
    <field name="DIG">0</field><field name="START">0</field><field name="TARGET">90</field><field name="STEP">15</field><field name="PAUSE">0.5</field>
    <next><block type="servo_descer_gradualmente"><field name="DIG">1</field><field name="START">180</field><field name="TARGET">90</field><field name="STEP">15</field><field name="PAUSE">0.5</field>
      <next><block type="esperar_segundos"><value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value></block></next>
    </block></next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Milissegundos controlam o pulso; a mensagem final permanece dois segundos. -->
  <block type="bloco_ligar_led" x="30" y="30"><value name="COLOUR"><block type="colour_blue"></block></value>
    <next><block type="esperar_milisegundos"><value name="TIME"><block type="tempo_milisegundos"><field name="NUM">1500</field></block></value>
      <next><block type="bloco_desligar_led"><value name="COLOUR"><block type="colour_blue"></block></value>
        <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">800</field></block></value>
          <next><block type="display_limpar"><field name="DISPLAY_TYPE">SMALL</field><next><block type="display_texto"><field name="TEXTO">Pulso pronto</field><field name="LINHA">1</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field><next><block type="esperar_segundos"><value name="TIME"><block type="math_number"><field name="NUM">2</field></block></value></block></next></block></next></block></next>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

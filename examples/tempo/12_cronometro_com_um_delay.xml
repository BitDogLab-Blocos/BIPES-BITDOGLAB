<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Exemplo de foco: um unico atraso de cinco segundos separa cada leitura, sem piscar a tela. -->
  <block type="cronometro_iniciar" x="30" y="30">
    <field name="NAME">leitura</field>
    <next>
      <block type="esperar_segundos">
        <value name="TIME"><block type="math_number"><field name="NUM">5</field></block></value>
        <next>
          <block type="display_texto">
            <field name="TEXTO">Apos 5 segundos</field>
            <field name="LINHA">1</field>
            <field name="ALINHAMENTO">CENTER</field>
            <field name="DISPLAY_TYPE">SMALL</field>
            <next>
              <block type="cronometro_mostrar">
                <field name="NAME">leitura</field>
                <field name="LINE">1</field>
                <field name="ALIGN">CENTER</field>
                <field name="FORMAT">SECONDS</field>
                <field name="DISPLAY_TYPE">SMALL</field>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

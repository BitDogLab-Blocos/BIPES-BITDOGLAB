<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Tres etapas em revezamento: A passa de crono 1 para 2, B passa para 3, C volta para 1; o joystick zera tudo. -->
  <block type="cronometro_iniciar" x="30" y="30">
    <field name="NAME">crono 1</field>
    <next>
      <block type="botao_se_apertado">
        <field name="BOTAO">A</field>
        <statement name="DO">
          <block type="cronometro_parar">
            <field name="NAME">crono 1</field>
            <next><block type="cronometro_iniciar"><field name="NAME">crono 2</field></block></next>
          </block>
        </statement>
        <next>
          <block type="botao_se_apertado">
            <field name="BOTAO">B</field>
            <statement name="DO">
              <block type="cronometro_parar">
                <field name="NAME">crono 2</field>
                <next><block type="cronometro_iniciar"><field name="NAME">crono 3</field></block></next>
              </block>
            </statement>
            <next>
              <block type="botao_se_apertado">
                <field name="BOTAO">C</field>
                <statement name="DO">
                  <block type="cronometro_parar">
                    <field name="NAME">crono 3</field>
                    <next><block type="cronometro_iniciar"><field name="NAME">crono 1</field></block></next>
                  </block>
                </statement>
                <next>
                  <block type="botao_se_apertado">
                    <field name="BOTAO">JOYSTICK</field>
                    <statement name="DO">
                      <block type="cronometro_reiniciar">
                        <field name="NAME">crono 1</field>
                        <next>
                          <block type="cronometro_iniciar">
                            <field name="NAME">crono 1</field>
                            <next>
                              <block type="cronometro_reiniciar">
                                <field name="NAME">crono 2</field>
                                <next><block type="cronometro_reiniciar"><field name="NAME">crono 3</field></block></next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <block type="display_texto">
                        <field name="TEXTO">C1:</field>
                        <field name="LINHA">1</field>
                        <field name="ALINHAMENTO">LEFT</field>
                        <field name="DISPLAY_TYPE">SMALL</field>
                        <next>
                          <block type="cronometro_mostrar">
                            <field name="NAME">crono 1</field>
                            <field name="LINE">0</field>
                            <field name="ALIGN">RIGHT</field>
                            <field name="FORMAT">SECONDS</field>
                            <field name="DISPLAY_TYPE">SMALL</field>
                            <next>
                              <block type="display_texto">
                                <field name="TEXTO">C2:</field>
                                <field name="LINHA">2</field>
                                <field name="ALINHAMENTO">LEFT</field>
                                <field name="DISPLAY_TYPE">SMALL</field>
                                <next>
                                  <block type="cronometro_mostrar">
                                    <field name="NAME">crono 2</field>
                                    <field name="LINE">1</field>
                                    <field name="ALIGN">RIGHT</field>
                                    <field name="FORMAT">SECONDS</field>
                                    <field name="DISPLAY_TYPE">SMALL</field>
                                    <next>
                                      <block type="display_texto">
                                        <field name="TEXTO">C3:</field>
                                        <field name="LINHA">3</field>
                                        <field name="ALINHAMENTO">LEFT</field>
                                        <field name="DISPLAY_TYPE">SMALL</field>
                                        <next>
                                          <block type="cronometro_mostrar">
                                            <field name="NAME">crono 3</field>
                                            <field name="LINE">2</field>
                                            <field name="ALIGN">RIGHT</field>
                                            <field name="FORMAT">SECONDS</field>
                                            <field name="DISPLAY_TYPE">SMALL</field>
                                            <next>
                                              <block type="display_texto">
                                                <field name="TEXTO">A&gt;B B&gt;C C&gt;A J=0</field>
                                                <field name="LINHA">5</field>
                                                <field name="ALINHAMENTO">CENTER</field>
                                                <field name="DISPLAY_TYPE">SMALL</field>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

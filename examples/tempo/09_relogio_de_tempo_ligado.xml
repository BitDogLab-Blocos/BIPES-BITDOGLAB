<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- O relogio mostra HH:MM:SS; tres segundos deixam a passagem visivel sem piscar. -->
  <block type="display_mostrar_tempo_ligado" x="30" y="30"><field name="LINE">0</field><field name="ALIGN">CENTER</field><field name="FORMAT">HMS</field><field name="DISPLAY_TYPE">SMALL</field>
    <next><block type="esperar_segundos"><value name="TIME"><block type="math_number"><field name="NUM">3</field></block></value></block></next>
  </block>
</xml>

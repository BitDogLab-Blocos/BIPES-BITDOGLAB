    <next><block type="display_texto"><field name="TEXTO">Aguardar 5s</field><field name="LINHA">1</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field>
      <next><block type="esperar_segundos"><value name="TIME"><block type="tempo_segundos"><field name="NUM">5</field></block></value>
        <next><block type="display_limpar"><field name="DISPLAY_TYPE">SMALL</field><next><block type="display_texto"><field name="TEXTO">Pronto!</field><field name="LINHA">1</field><field name="ALINHAMENTO">CENTER</field><field name="DISPLAY_TYPE">SMALL</field><next><block type="esperar_segundos"><value name="TIME"><block type="math_number"><field name="NUM">2</field></block></value></block></next></block></next></block></next>
      </block></next>
    </block></next>
  </block>
</xml>

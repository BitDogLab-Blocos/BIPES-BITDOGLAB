<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Painel de formatos: A pausa, B retoma e C reinicia; o mesmo tempo aparece como HH:MM:SS e MM:SS.ms. -->
  <block type="cronometro_iniciar" x="30" y="30">
    <field name="NAME">painel</field>
    <next>
      <block type="botao_se_apertado">
        <field name="BOTAO">A</field>
        <statement name="DO"><block type="cronometro_parar"><field name="NAME">painel</field></block></statement>
        <next>
          <block type="botao_se_apertado">
            <field name="BOTAO">B</field>
            <statement name="DO"><block type="cronometro_iniciar"><field name="NAME">painel</field></block></statement>
            <next>
              <block type="botao_se_apertado">
                <field name="BOTAO">C</field>
                <statement name="DO"><block type="cronometro_reiniciar"><field name="NAME">painel</field><next><block type="cronometro_iniciar"><field name="NAME">painel</field></block></next></block></statement>
                <next>
                  <block type="display_texto">
                    <field name="TEXTO">Horas:Min:Seg</field>
                    <field name="LINHA">1</field>
                    <field name="ALINHAMENTO">LEFT</field>
                    <field name="DISPLAY_TYPE">SMALL</field>
                    <next>
                      <block type="cronometro_mostrar">
                        <field name="NAME">painel</field>
                        <field name="LINE">1</field>
                        <field name="ALIGN">CENTER</field>
                        <field name="FORMAT">HMS</field>
                        <field name="DISPLAY_TYPE">SMALL</field>
                        <next>
                          <block type="display_texto">
                            <field name="TEXTO">Min:Seg.cent</field>
                            <field name="LINHA">3</field>
                            <field name="ALINHAMENTO">LEFT</field>
                            <field name="DISPLAY_TYPE">SMALL</field>
                            <next>
                              <block type="cronometro_mostrar">
                                <field name="NAME">painel</field>
                                <field name="LINE">3</field>
                                <field name="ALIGN">CENTER</field>
                                <field name="FORMAT">MS_MILLI</field>
                                <field name="DISPLAY_TYPE">SMALL</field>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

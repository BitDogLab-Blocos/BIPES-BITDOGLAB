<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Sequência numérica: apresenta os números de 0 a 4, um por segundo. -->
  <block type="mostrar_numero_matriz" x="20" y="20">
    <field name="BRILHO">30</field>
    <value name="NUMERO"><block type="numero_matriz_0"></block></value>
    <value name="COR"><block type="colour_cyan"></block></value>
    <next>
      <block type="esperar_segundos">
        <value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
        <next>
          <block type="mostrar_numero_matriz">
            <field name="BRILHO">30</field>
            <value name="NUMERO"><block type="numero_matriz_1"></block></value>
            <value name="COR"><block type="colour_green"></block></value>
            <next>
              <block type="esperar_segundos">
                <value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
                <next>
                  <block type="mostrar_numero_matriz">
                    <field name="BRILHO">30</field>
                    <value name="NUMERO"><block type="numero_matriz_2"></block></value>
                    <value name="COR"><block type="colour_yellow"></block></value>
                    <next>
                      <block type="esperar_segundos">
                        <value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
                        <next>
                          <block type="mostrar_numero_matriz">
                            <field name="BRILHO">30</field>
                            <value name="NUMERO"><block type="numero_matriz_3"></block></value>
                            <value name="COR"><block type="colour_orange"></block></value>
                            <next>
                              <block type="esperar_segundos">
                                <value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
                                <next>
                                  <block type="mostrar_numero_matriz">
                                    <field name="BRILHO">30</field>
                                    <value name="NUMERO"><block type="numero_matriz_4"></block></value>
                                    <value name="COR"><block type="colour_red"></block></value>
                                    <next>
                                      <block type="esperar_segundos">
                                        <value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- O microfone mede o som: acima de 3, vermelho; caso contrário, verde. -->
  <block type="microfone_vu_meter" x="20" y="20"><field name="BRILHO">30</field><value name="COR"><block type="colour_blue"></block></value>
    <next><block type="controls_ifelse">
      <value name="IF0"><block type="logic_compare"><field name="OP">GT</field><value name="A"><block type="microfone_nivel_atual"></block></value><value name="B"><block type="math_number"><field name="NUM">3</field></block></value></block></value>
      <statement name="DO0"><block type="led_externo_ligar"><field name="CHANNEL">R</field><field name="DIG">0</field><next><block type="bipe_curto"><field name="VOLUME">30</field></block></next></block></statement>
      <statement name="ELSE"><block type="led_externo_ligar"><field name="CHANNEL">G</field><field name="DIG">1</field></block></statement>
      <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">200</field></block></value><next><block type="led_externo_desligar_todos"></block></next></block></next></block></next>
  </block>
</xml>

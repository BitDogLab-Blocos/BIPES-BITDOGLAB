<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Com GND como fio comum, um toque na Conexão 0 mostra o número 2 na Matriz de LEDs. -->
  <block type="external_contact_prepare" x="20" y="20">
    <field name="COMMON">GND</field>
    <next>
      <block type="external_contact_when_closed">
        <field name="DIG">0</field>
        <statement name="DO">
          <block type="mostrar_numero_matriz">
            <field name="BRILHO">30</field>
            <value name="NUMERO">
              <block type="numero_matriz_2" />
            </value>
            <value name="COR">
              <block type="colour_green" />
            </value>
            <next>
              <block type="esperar_milisegundos">
                <value name="TIME">
                  <block type="math_number">
                    <field name="NUM">1000</field>
                  </block>
                </value>
                <next>
                  <block type="desligar_matriz" />
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>

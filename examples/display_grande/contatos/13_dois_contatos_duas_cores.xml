<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Com GND como fio comum, um contato nas Conexões 0 ou 1 acende vermelho; os dois juntos acendem verde no LED da placa. -->
  <block type="external_contact_prepare" x="20" y="20">
    <field name="COMMON">GND</field>
    <next>
      <block type="controls_ifelse">
        <value name="IF0">
          <block type="logic_operation">
            <field name="OP">AND</field>
            <value name="A">
              <block type="external_contact_is_closed">
                <field name="DIG">0</field>
              </block>
            </value>
            <value name="B">
              <block type="external_contact_is_closed">
                <field name="DIG">1</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="bloco_ligar_led">
            <value name="COLOUR">
              <block type="colour_green" />
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="controls_ifelse">
            <value name="IF0">
              <block type="logic_operation">
                <field name="OP">OR</field>
                <value name="A">
                  <block type="external_contact_is_closed">
                    <field name="DIG">0</field>
                  </block>
                </value>
                <value name="B">
                  <block type="external_contact_is_closed">
                    <field name="DIG">1</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="bloco_ligar_led">
                <value name="COLOUR">
                  <block type="colour_red" />
                </value>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="bloco_desligar_todos_leds" />
            </statement>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>

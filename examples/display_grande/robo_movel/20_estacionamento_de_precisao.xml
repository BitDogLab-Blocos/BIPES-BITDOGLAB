<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Estacionamento: A faz a manobra completa; C interrompe e avisa com luz e som. -->
  <block type="robo_inicializar" x="20" y="20">
    <field name="ESPERA">5</field>
    <next><block type="botao_se_apertado">
      <field name="BOTAO">A</field>
      <statement name="DO"><block type="robo_frente">
        <value name="TEMPO"><block type="math_number"><field name="NUM">1</field></block></value>
        <next><block type="robo_girar"><field name="DIRECAO">R</field><value name="GRAUS"><block type="math_number"><field name="NUM">180</field></block></value>
          <next><block type="robo_tras"><value name="TEMPO"><block type="math_number"><field name="NUM">0.5</field></block></value>
            <next><block type="robo_parar"><next><block type="bipe_curto"><field name="VOLUME">25</field></block></next></block></next>
          </block></next>
        </block></next>
      </block></statement>
      <next><block type="botao_se_apertado">
        <field name="BOTAO">C</field>
        <statement name="DO"><block type="robo_parar"><next><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_red"></block></value><next><block type="bipe_duplo"><field name="VOLUME">30</field></block></next></block></next></block></statement>
      </block></next>
    </block></next>
  </block>
</xml>

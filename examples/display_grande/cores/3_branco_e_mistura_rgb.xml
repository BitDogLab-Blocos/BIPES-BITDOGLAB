<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Compara o branco pronto com a média de vermelho, verde e azul, que produz um branco mais fraco. -->
  <block type="bloco_ligar_led" x="20" y="20">
    <value name="COLOUR"><block type="colour_white"></block></value>
    <next>
      <block type="esperar_segundos">
        <value name="TIME"><block type="math_number"><field name="NUM">2</field></block></value>
        <next>
          <block type="bloco_ligar_led">
            <value name="COLOUR">
              <block type="mix_colours">
                <mutation items="3"></mutation>
                <value name="ADD0"><block type="colour_red"></block></value>
                <value name="ADD1"><block type="colour_green"></block></value>
                <value name="ADD2"><block type="colour_blue"></block></value>
              </block>
            </value>
            <next>
              <block type="esperar_segundos">
                <value name="TIME"><block type="math_number"><field name="NUM">2</field></block></value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

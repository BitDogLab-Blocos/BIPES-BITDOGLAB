<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Explorador triádico: os botões A, B e C selecionam vermelho, verde e azul; o joystick apaga o LED. -->
  <block type="botao_se_apertado" x="20" y="20">
    <field name="BOTAO">A</field>
    <statement name="DO">
      <block type="bloco_ligar_led">
        <value name="COLOUR"><block type="colour_red"></block></value>
      </block>
    </statement>
    <next>
      <block type="botao_se_apertado">
        <field name="BOTAO">B</field>
        <statement name="DO">
          <block type="bloco_ligar_led">
            <value name="COLOUR"><block type="colour_green"></block></value>
          </block>
        </statement>
        <next>
          <block type="botao_se_apertado">
            <field name="BOTAO">C</field>
            <statement name="DO">
              <block type="bloco_ligar_led">
                <value name="COLOUR"><block type="colour_blue"></block></value>
              </block>
            </statement>
            <next>
              <block type="botao_se_apertado">
                <field name="BOTAO">JOYSTICK</field>
                <statement name="DO">
                  <block type="bloco_desligar_todos_leds"></block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

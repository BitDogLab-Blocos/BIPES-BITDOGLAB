<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Alerta de segurança: quando o servo chega a 150 graus ou mais, toca um bipe; abaixo disso o som para. -->
  <block type="servo_joystick_controlar" x="20" y="20">
    <field name="DIG">0</field><field name="INITIAL_ANGLE">90</field><field name="DIR_INCREASE">UP</field><field name="DIR_DECREASE">DOWN</field><field name="STEP">5</field>
    <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">500</field></block></value>
      <next><block type="controls_if">
        <value name="IF0"><block type="logic_compare"><field name="OP">GTE</field><value name="A"><block type="servo_angulo_atual"><field name="DIG">0</field></block></value><value name="B"><block type="math_number"><field name="NUM">150</field></block></value></block></value>
        <statement name="DO0"><block type="bipe_curto"><field name="VOLUME">30</field></block></statement>
      </block></next>
    </block></next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Semáforo angular: verde abaixo de 60 graus, amarelo entre 60 e 119, e vermelho a partir de 120 graus. -->
  <block type="servo_joystick_controlar" x="20" y="20">
    <field name="DIG">0</field><field name="INITIAL_ANGLE">90</field><field name="DIR_INCREASE">UP</field><field name="DIR_DECREASE">DOWN</field><field name="STEP">4</field>
    <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">300</field></block></value>
      <next><block type="bloco_desligar_todos_leds">
        <next><block type="controls_ifelse">
        <value name="IF0"><block type="logic_compare"><field name="OP">LT</field><value name="A"><block type="servo_angulo_atual"><field name="DIG">0</field></block></value><value name="B"><block type="math_number"><field name="NUM">60</field></block></value></block></value>
        <statement name="DO0"><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_green"></block></value></block></statement>
        <statement name="ELSE"><block type="controls_ifelse">
          <value name="IF0"><block type="logic_compare"><field name="OP">LT</field><value name="A"><block type="servo_angulo_atual"><field name="DIG">0</field></block></value><value name="B"><block type="math_number"><field name="NUM">120</field></block></value></block></value>
          <statement name="DO0"><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_yellow"></block></value></block></statement>
          <statement name="ELSE"><block type="bloco_ligar_led"><value name="COLOUR"><block type="colour_red"></block></value></block></statement>
        </block></statement>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

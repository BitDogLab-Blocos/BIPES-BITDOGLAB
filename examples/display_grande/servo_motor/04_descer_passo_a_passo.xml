<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Movimento gradual contrário: a repetição executa uma descida completa de 180 até 30 graus. -->
  <block type="controls_repeat_simple" x="20" y="20">
    <field name="TIMES">1</field>
    <statement name="DO">
      <block type="servo_descer_gradualmente">
        <field name="DIG">0</field><field name="START">180</field><field name="TARGET">30</field><field name="STEP">30</field><field name="PAUSE">1</field>
      </block>
    </statement>
  </block>
</xml>

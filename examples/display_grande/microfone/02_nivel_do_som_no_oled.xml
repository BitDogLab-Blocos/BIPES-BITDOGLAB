<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- A matriz reage ao som e o OLED mostra um nível de 0 a 5. -->
  <block x="30" y="30" type="microfone_vu_meter">
    <field name="BRILHO">30</field>
    <value name="COR">
      <block type="colour_cyan">
      </block>
    </value>
    <next>
      <block type="display_texto">
        <field name="TEXTO">Nivel do som:</field>
        <field name="LINHA">1</field>
        <field name="ALINHAMENTO">LEFT</field>
        <field name="DISPLAY_TYPE">LARGE</field>
        <next>
          <block type="display_mostrar_valor">
            <field name="LINHA">1</field>
            <field name="ALINHAMENTO">RIGHT</field>
            <field name="DISPLAY_TYPE">LARGE</field>
            <value name="VALOR">
              <block type="microfone_nivel_atual">
                  </block>
            </value>
            <next>
              <block type="esperar_milisegundos">
                <value name="TIME">
                  <block type="math_number">
                    <field name="NUM">100</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

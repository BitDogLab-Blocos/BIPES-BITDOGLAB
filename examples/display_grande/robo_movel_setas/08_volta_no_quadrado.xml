<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Uma volta completa: cima, direita, baixo e esquerda. -->
  <block type="robo_setas_iniciar" x="30" y="30">
    <next><block type="robo_setas_frente">
      <next><block type="robo_setas_direita">
        <next><block type="robo_setas_voltar">
          <next><block type="robo_setas_esquerda">
            <next><block type="robo_setas_finalizar"></block></next>
          </block></next>
        </block></next>
      </block></next>
    </block></next>
  </block>
</xml>

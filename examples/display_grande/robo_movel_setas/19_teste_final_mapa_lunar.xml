<?xml version="1.0" encoding="utf-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <!--Mapa 5x6; inicie em D1 apontado para a linha 6. Rota: D1-D2-D3-D4-D5-C5-B5-B6-B5-C5. Bipes e OLED marcam os pontos de checagem.-->
  <block type="robo_setas_iniciar" x="30" y="30">
    <next>
      <block type="display_limpar">
        <field name="DISPLAY_TYPE">LARGE</field>
        <next>
          <block type="display_texto">
            <field name="TEXTO">D1 INICIO</field>
            <field name="LINHA">2</field>
            <field name="ALINHAMENTO">CENTER</field>
            <field name="DISPLAY_TYPE">LARGE</field>
            <next>
              <block type="bloco_ligar_led">
                <value name="COLOUR">
                  <block type="colour_blue" />
                </value>
                <next>
                  <block type="bipe_curto">
                    <field name="VOLUME">25</field>
                    <next>
                      <block type="robo_setas_frente">
                        <next>
                          <block type="robo_setas_frente">
                            <next>
                              <block type="mostrar_emoji">
                                <field name="BRILHO">20</field>
                                <value name="EMOJI">
                                  <block type="emoji_seta_cima" />
                                </value>
                                <value name="COR">
                                  <block type="colour_blue" />
                                </value>
                                <next>
                                  <block type="display_limpar_linha">
                                    <field name="LINHA">2</field>
                                    <field name="DISPLAY_TYPE">LARGE</field>
                                    <next>

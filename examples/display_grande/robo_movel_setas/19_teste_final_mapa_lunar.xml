                                                                                                                                </value>
                                                                                                                                <value name="COR">
                                                                                                                                  <block type="colour_green" />
                                                                                                                                </value>
                                                                                                                                <next>
                                                                                                                                  <block type="som_de_sucesso">
                                                                                                                                    <field name="VOLUME">30</field>
                                                                                                                                    <next>
                                                                                                                                      <block type="bloco_desligar_todos_leds">
                                                                                                                                        <next>
                                                                                                                                          <block type="robo_setas_finalizar" />
                                                                                                                                        </next>
                                                                                                                                      </block>
                                                                                                                                    </next>
                                                                                                                                  </block>
                                                                                                                                </next>
                                                                                                                              </block>
                                                                                                                            </next>
                                                                                                                          </block>
                                                                                                                        </next>
                                                                                                                      </block>
                                                                                                                    </next>
                                                                                                                  </block>
                                                                                                                </next>
                                                                                                              </block>
                                                                                                            </next>
                                                                                                          </block>
                                                                                                        </next>
                                                                                                      </block>
                                                                                                    </next>
                                                                                                  </block>
                                                                                                </next>

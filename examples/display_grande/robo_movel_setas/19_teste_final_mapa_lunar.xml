                                                                                <next>
                                                                                  <block type="mostrar_emoji">
                                                                                    <field name="BRILHO">20</field>
                                                                                    <value name="EMOJI">
                                                                                      <block type="emoji_coracao" />
                                                                                    </value>
                                                                                    <value name="COR">
                                                                                      <block type="colour_pink" />
                                                                                    </value>
                                                                                    <next>

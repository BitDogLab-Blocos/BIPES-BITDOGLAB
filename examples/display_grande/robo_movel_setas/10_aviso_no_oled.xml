<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Mostra VIRE antes da curva e CHEGOU ao final, sem sobrepor os textos. -->
  <block type="robo_setas_iniciar" x="30" y="30">
    <next>
      <block type="robo_setas_frente">
        <next>
          <block type="display_limpar">
            <field name="DISPLAY_TYPE">LARGE</field>
            <next>
              <block type="display_texto">
                <field name="TEXTO">VIRE</field>
                <field name="LINHA">2</field>
                <field name="ALINHAMENTO">CENTER</field>
                <field name="DISPLAY_TYPE">LARGE</field>
                <next>
                  <block type="esperar_segundos">
                    <value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
                    <next>
                      <block type="robo_setas_direita">
                        <next>
                          <block type="display_limpar_linha">
                            <field name="LINHA">2</field>
                            <field name="DISPLAY_TYPE">LARGE</field>
                            <next>
                              <block type="display_texto">
                                <field name="TEXTO">CHEGOU</field>
                                <field name="LINHA">2</field>
                                <field name="ALINHAMENTO">CENTER</field>
                                <field name="DISPLAY_TYPE">LARGE</field>
                                <next>
                                  <block type="esperar_segundos">
                                    <value name="TIME"><block type="math_number"><field name="NUM">1</field></block></value>
                                    <next><block type="robo_setas_finalizar" /></next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Repetir duas vezes a sequencia cima e direita. -->
  <block type="robo_setas_iniciar" x="30" y="30">
    <next><block type="controls_repeat_simple">
      <field name="TIMES">2</field>
      <statement name="DO"><block type="robo_setas_frente">
        <next><block type="robo_setas_direita"></block></next>
      </block></statement>
      <next><block type="robo_setas_finalizar"></block></next>
    </block></next>
  </block>
</xml>

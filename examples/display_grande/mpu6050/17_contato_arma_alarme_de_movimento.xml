<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- O contato na Conexao 1 arma o alarme; ao mover o MPU6050, o LED externo vermelho da Conexao 0 e um bipe avisam. -->
  <block type="external_contact_prepare" x="20" y="20"><field name="COMMON">GND</field>
    <next><block type="controls_ifelse">
      <value name="IF0"><block type="logic_operation"><field name="OP">AND</field>
        <value name="A"><block type="external_contact_is_closed"><field name="DIG">1</field></block></value>
        <value name="B"><block type="mpu6050_foi_movimentado"><field name="SCL">3</field><field name="SDA">2</field></block></value>
      </block></value>
      <statement name="DO0"><block type="led_externo_ligar"><field name="CHANNEL">R</field><field name="DIG">0</field><next><block type="bipe_duplo"><field name="VOLUME">25</field><next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">700</field></block></value></block></next></block></next></block></statement>
      <statement name="ELSE"><block type="led_externo_desligar"><field name="CHANNEL">R</field><field name="DIG">0</field><next><block type="parar_som"></block></next></block></statement>
      <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">300</field></block></value></block></next>
    </block></next>
  </block>
</xml>

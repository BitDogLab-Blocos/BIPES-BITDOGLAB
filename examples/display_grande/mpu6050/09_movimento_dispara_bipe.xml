<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Um bipe curto confirma cada movimento intencional reconhecido pelo MPU6050. -->
  <block type="controls_if" x="20" y="20">
    <value name="IF0"><block type="mpu6050_foi_movimentado"><field name="SCL">3</field><field name="SDA">2</field></block></value>
    <statement name="DO0"><block type="bipe_curto"><field name="VOLUME">25</field><next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">600</field></block></value></block></next></block></statement>
    <next><block type="esperar_milisegundos"><value name="TIME"><block type="math_number"><field name="NUM">300</field></block></value></block></next>
  </block>
</xml>

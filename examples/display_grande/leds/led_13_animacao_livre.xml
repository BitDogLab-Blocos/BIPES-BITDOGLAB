<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Dança de luzes: cada cor acende, permanece visível e apaga antes da próxima. -->
  <block type="bloco_criar_animacao_led" x="20" y="20">
    <mutation steps="[&quot;action&quot;,&quot;wait&quot;,&quot;action&quot;,&quot;wait&quot;,&quot;action&quot;,&quot;wait&quot;,&quot;action&quot;,&quot;wait&quot;,&quot;action&quot;,&quot;wait&quot;,&quot;action&quot;,&quot;wait&quot;]"></mutation>
    <statement name="STEP0">
      <block type="bloco_ligar_led">
        <value name="COLOUR"><block type="colour_red"></block></value>
      </block>
    </statement>
    <value name="STEP1"><block type="tempo_milisegundos"><field name="NUM">800</field></block></value>
    <statement name="STEP2"><block type="bloco_desligar_todos_leds"></block></statement>
    <value name="STEP3"><block type="tempo_milisegundos"><field name="NUM">300</field></block></value>
    <statement name="STEP4">
      <block type="bloco_ligar_led">
        <value name="COLOUR"><block type="colour_blue"></block></value>
      </block>
    </statement>
    <value name="STEP5"><block type="tempo_milisegundos"><field name="NUM">800</field></block></value>
    <statement name="STEP6"><block type="bloco_desligar_todos_leds"></block></statement>
    <value name="STEP7"><block type="tempo_milisegundos"><field name="NUM">300</field></block></value>
    <statement name="STEP8">
      <block type="bloco_ligar_led">
        <value name="COLOUR"><block type="colour_green"></block></value>
      </block>
    </statement>
    <value name="STEP9"><block type="tempo_milisegundos"><field name="NUM">800</field></block></value>
    <statement name="STEP10"><block type="bloco_desligar_todos_leds"></block></statement>
    <value name="STEP11"><block type="tempo_milisegundos"><field name="NUM">1000</field></block></value>
  </block>
</xml>

<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Zere seu placar. A soma um ponto; B volta a zero. Faça dez pontos e comece outra rodada. -->
  <block x="30" y="30" type="variables_guardar">
    <field name="VAR">pontos</field>
    <value name="VALUE">
      <block type="math_number">
        <field name="NUM">0</field>
      </block>
    </value>
    <next>
      <block type="botao_se_apertado">
        <field name="BOTAO">A</field>
        <statement name="DO">
          <block type="variables_adicionar">
            <field name="VAR">pontos</field>
            <value name="AMOUNT">
              <block type="math_number">
                <field name="NUM">1</field>
              </block>
            </value>
          </block>
        </statement>
        <next>
          <block type="botao_se_apertado">
            <field name="BOTAO">B</field>
            <statement name="DO">
              <block type="variables_guardar">
                <field name="VAR">pontos</field>
                <value name="VALUE">
                  <block type="math_number">
                    <field name="NUM">0</field>
                  </block>
                </value>
              </block>
            </statement>
            <next>
              <block type="display_texto">
                <field name="TEXTO">A soma / B zera</field>
                <field name="LINHA">1</field>
                <field name="ALINHAMENTO">LEFT</field>
                <field name="DISPLAY_TYPE">LARGE</field>
                <next>
                  <block type="display_mostrar_valor">
                    <field name="LINHA">2</field>
                    <field name="ALINHAMENTO">CENTER</field>
                    <field name="DISPLAY_TYPE">LARGE</field>
                    <value name="VALOR">
                      <block type="variables_valor_guardado">
                        <field name="VAR">pontos</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>

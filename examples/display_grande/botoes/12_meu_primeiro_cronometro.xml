<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Controle seu cronômetro. A inicia ou retoma; B pausa; C zera e deixa parado. O tempo aparece no OLED. -->
  <block x="30" y="30" type="botao_se_apertado">
    <field name="BOTAO">A</field>
    <statement name="DO">
      <block type="cronometro_iniciar">
        <field name="NAME">relogio</field>
      </block>
    </statement>
    <next>
      <block type="botao_se_apertado">
        <field name="BOTAO">B</field>
        <statement name="DO">
          <block type="cronometro_parar">
            <field name="NAME">relogio</field>
          </block>
        </statement>
        <next>
          <block type="botao_se_apertado">
            <field name="BOTAO">C</field>
            <statement name="DO">
              <block type="cronometro_reiniciar">
                <field name="NAME">relogio</field>
              </block>
            </statement>
            <next>
              <block type="display_texto">
                <field name="TEXTO">A vai B para</field>
                <field name="LINHA">1</field>
                <field name="ALINHAMENTO">LEFT</field>
                <field name="DISPLAY_TYPE">LARGE</field>
                <next>
                  <block type="cronometro_mostrar">
                    <field name="NAME">relogio</field>
                    <field name="LINE">2</field>
                    <field name="ALIGN">CENTER</field>
                    <field name="FORMAT">S_MILLI</field>
                    <field name="DISPLAY_TYPE">LARGE</field>
                    <next>
                      <block type="display_texto">
                        <field name="TEXTO">C zera</field>
                        <field name="LINHA">5</field>
                        <field name="ALINHAMENTO">LEFT</field>
                        <field name="DISPLAY_TYPE">LARGE</field>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
